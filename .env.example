# Database
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=savedbythemaid
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_app_password

# JWT Authentication
JWT_SECRET=change_me_min_32_chars_long_secret_key

# Application
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5000
FRONTEND_PORT=3000

# CORS (comma-separated)
CORS_ORIGINS=https://savedbythemaid.com,https://www.savedbythemaid.com

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@savedbythemaid.com
