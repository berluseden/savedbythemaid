{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "SavedByTheMaid.Api.Controllers.BookingController": "Information",
        "SavedByTheMaid.Api.BackgroundServices": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/savedbythemaid-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithEnvironmentName", "WithMachineName", "WithThreadId"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=172.18.0.2;Port=3306;Database=SavedByTheMaidNew;User=root;Password=Root@123456;"
  },
  "Jwt": {
    "Secret": "SavedByTheMaid_SuperSecretKey_2026_Production_Ready_Key_256bits!",
    "Issuer": "SavedByTheMaid",
    "Audience": "SavedByTheMaidApp",
    "ExpirationMinutes": 60,
    "RefreshExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://savedbythemaid.com"
    ]
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowMinutes": 1,
    "BookingPermitLimit": 10,
    "BookingWindowMinutes": 1
  },
  "Monitoring": {
    "EnableMetrics": true,
    "EnableHealthChecks": true,
    "PricingMismatchAlertThreshold": 0.01,
    "SoftReserveCleanupIntervalMinutes": 5
  }
}
