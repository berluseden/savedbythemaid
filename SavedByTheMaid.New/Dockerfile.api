# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files
COPY SavedByTheMaid.sln ./
COPY src/SavedByTheMaid.Api/SavedByTheMaid.Api.csproj src/SavedByTheMaid.Api/
COPY src/SavedByTheMaid.Application/SavedByTheMaid.Application.csproj src/SavedByTheMaid.Application/
COPY src/SavedByTheMaid.Domain/SavedByTheMaid.Domain.csproj src/SavedByTheMaid.Domain/
COPY src/SavedByTheMaid.Infrastructure/SavedByTheMaid.Infrastructure.csproj src/SavedByTheMaid.Infrastructure/

# Restore dependencies
RUN dotnet restore

# Copy the rest of the source code
COPY src/ src/

# Build the API project
WORKDIR /src/src/SavedByTheMaid.Api
RUN dotnet build SavedByTheMaid.Api.csproj -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish SavedByTheMaid.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy published files
COPY --from=publish /app/publish .

# Expose ports
EXPOSE 5000
EXPOSE 5001

# Set environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "SavedByTheMaid.Api.dll"]
