# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy all project files in correct structure
COPY src/SavedByTheMaid.Domain/SavedByTheMaid.Domain.csproj src/SavedByTheMaid.Domain/
COPY src/SavedByTheMaid.Application/SavedByTheMaid.Application.csproj src/SavedByTheMaid.Application/
COPY src/SavedByTheMaid.Infrastructure/SavedByTheMaid.Infrastructure.csproj src/SavedByTheMaid.Infrastructure/
COPY src/SavedByTheMaid.Api/SavedByTheMaid.Api.csproj src/SavedByTheMaid.Api/

# Restore dependencies for Api project (will restore all dependencies)
WORKDIR /src/src/SavedByTheMaid.Api
RUN dotnet restore

# Copy all source code
WORKDIR /src
COPY src/ src/

# Build
WORKDIR /src/src/SavedByTheMaid.Api
RUN dotnet build SavedByTheMaid.Api.csproj -c Release -o /app/build --no-restore

# Publish stage
FROM build AS publish
RUN dotnet publish SavedByTheMaid.Api.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy published files
COPY --from=publish /app/publish .

# Expose ports
EXPOSE 5000

# Set environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "SavedByTheMaid.Api.dll"]
