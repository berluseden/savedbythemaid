@using EService.Web.Views.Manage
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav class="manage-nav">
    <h6 class="nav-header mb-3 text-muted fw-semibold text-uppercase small">Account</h6>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a asp-action="Index" class="nav-link @ManageNavPages.IndexNavClass(ViewContext)">
                <i class="bi bi-person"></i> Profile
            </a>
        </li>
        <li class="nav-item">
            <a asp-action="ChangePassword" class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)">
                <i class="bi bi-key"></i> Password
            </a>
        </li>
        @if (hasExternalLogins)
        {
            <li class="nav-item">
                <a asp-action="ExternalLogins" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)">
                    <i class="bi bi-link-45deg"></i> External Logins
                </a>
            </li>
        }
        <li class="nav-item">
            <a asp-action="TwoFactorAuthentication" class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)">
                <i class="bi bi-shield-lock"></i> Two-Factor Auth
            </a>
        </li>
    </ul>
    
    <hr class="my-3">
    
    <h6 class="nav-header mb-3 text-muted fw-semibold text-uppercase small">Quick Links</h6>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a asp-controller="Cart" asp-action="Index" class="nav-link">
                <i class="bi bi-cart3"></i> My Cart
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Booking" asp-action="Schedule" class="nav-link">
                <i class="bi bi-calendar-plus"></i> Book Service
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link">
                <i class="bi bi-house"></i> Home
            </a>
        </li>
    </ul>
</nav>

