@model IndexViewModel
@{
    ViewData["Title"] = "Profile";
    ViewData.AddActivePage(ManageNavPages.Index);
}

<div class="profile-section">
    <div class="section-header mb-4">
        <h4 class="fw-bold"><i class="bi bi-person me-2 text-primary"></i>@ViewData["Title"]</h4>
        <p class="text-muted mb-0">Update your personal information</p>
    </div>
    
    @Html.Partial("_StatusMessage", Model.StatusMessage)
    
    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>
        
        <div class="row g-4">
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Username" class="form-control" disabled />
                    <label asp-for="Username"><i class="bi bi-person-badge me-2"></i>Username</label>
                </div>
                <small class="text-muted">Username cannot be changed</small>
            </div>
            
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Email" class="form-control" />
                    <label asp-for="Email"><i class="bi bi-envelope me-2"></i>Email Address</label>
                </div>
                @if (Model.IsEmailConfirmed)
                {
                    <small class="text-success"><i class="bi bi-check-circle me-1"></i>Email verified</small>
                }
                else
                {
                    <div class="mt-2">
                        <small class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Email not verified</small>
                        <button asp-action="SendVerificationEmail" class="btn btn-link btn-sm p-0 ms-2">Send verification email</button>
                    </div>
                }
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone" />
                    <label asp-for="PhoneNumber"><i class="bi bi-telephone me-2"></i>Phone Number</label>
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Save Changes
            </button>
        </div>
    </form>
</div>

<style>
    .profile-section .form-floating > .form-control { border-radius: 0.75rem; }
    .profile-section .form-floating > .form-control:focus { border-color: var(--primary-color); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
    .profile-section .form-floating > .form-control:disabled { background: #f8fafc; }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
