@{ 
    Layout = "/Views/Shared/_CustomerLayout.cshtml";
}

<!-- Account Management Section -->
<section class="manage-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Page Header -->
                <div class="manage-header mb-5" data-aos="fade-up">
                    <span class="badge bg-primary-subtle text-primary mb-3 px-3 py-2 rounded-pill">
                        <i class="bi bi-person-gear me-2"></i>Account Settings
                    </span>
                    <h1 class="display-6 fw-bold">Manage Your Account</h1>
                    <p class="text-muted">Update your profile, security settings, and preferences</p>
                </div>
                
                <div class="row g-4">
                    <!-- Sidebar Navigation -->
                    <div class="col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                        <div class="manage-sidebar">
                            @await Html.PartialAsync("_ManageNav")
                        </div>
                    </div>
                    
                    <!-- Main Content -->
                    <div class="col-md-8 col-lg-9" data-aos="fade-up" data-aos-delay="200">
                        <div class="manage-content">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @RenderSection("Scripts", required: false)
    
    <style>
        .manage-section { min-height: 70vh; }
        .manage-header { text-align: center; }
        .manage-sidebar { background: white; border-radius: 1rem; padding: 1.5rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); position: sticky; top: 100px; }
        .manage-content { background: white; border-radius: 1rem; padding: 2rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); }
        
        /* Nav Pills Styling */
        .manage-sidebar .nav-link { display: flex; align-items: center; padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 0.5rem; color: #64748b; transition: all 0.3s ease; }
        .manage-sidebar .nav-link:hover { background: rgba(37, 99, 235, 0.05); color: var(--primary-color); }
        .manage-sidebar .nav-link.active { background: var(--primary-color); color: white; }
        .manage-sidebar .nav-link i { margin-right: 0.75rem; font-size: 1.1rem; }
    </style>
}
        
