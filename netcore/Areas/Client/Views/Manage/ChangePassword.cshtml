@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

<div class="password-section">
    <div class="section-header mb-4">
        <h4 class="fw-bold"><i class="bi bi-key me-2 text-primary"></i>@ViewData["Title"]</h4>
        <p class="text-muted mb-0">Keep your account secure with a strong password</p>
    </div>
    
    @Html.Partial("_StatusMessage", Model.StatusMessage)
    
    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>
        
        <div class="row g-4">
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="OldPassword" class="form-control" placeholder="Current Password" />
                    <label asp-for="OldPassword"><i class="bi bi-lock me-2"></i>Current Password</label>
                </div>
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>
            
            <div class="col-12"><hr class="my-2"></div>
            
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="NewPassword" class="form-control" placeholder="New Password" />
                    <label asp-for="NewPassword"><i class="bi bi-lock-fill me-2"></i>New Password</label>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <small class="text-muted">Minimum 6 characters</small>
            </div>
            
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm New Password" />
                    <label asp-for="ConfirmPassword"><i class="bi bi-shield-check me-2"></i>Confirm New Password</label>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        
        <div class="mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Update Password
            </button>
        </div>
    </form>
</div>

<style>
    .password-section .form-floating > .form-control { border-radius: 0.75rem; }
    .password-section .form-floating > .form-control:focus { border-color: var(--primary-color); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
