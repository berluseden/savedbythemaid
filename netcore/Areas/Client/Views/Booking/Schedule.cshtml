@{
    ViewData["Title"] = "Book Your Cleaning";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- Booking Hero Section -->
<section class="booking-hero py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center" data-aos="fade-up">
                <span class="badge bg-primary-subtle text-primary mb-3 px-3 py-2 rounded-pill">
                    <i class="bi bi-calendar-check me-2"></i>Quick & Easy Booking
                </span>
                <h1 class="display-5 fw-bold mb-3">Schedule Your Cleaning</h1>
                <p class="lead text-muted mb-0">Complete the form below to book your professional cleaning service</p>
            </div>
        </div>
    </div>
</section>

<!-- Booking Form Section -->
<section class="booking-form-section pb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Progress Steps -->
                <div class="booking-progress mb-5" data-aos="fade-up" data-aos-delay="100">
                    <div class="progress-track">
                        <div class="progress-bar-fill" id="progressBar"></div>
                    </div>
                    <div class="progress-steps d-flex justify-content-between">
                        <div class="progress-step active" data-step="1">
                            <div class="step-circle">
                                <span class="step-number">1</span>
                                <i class="bi bi-check-lg step-check"></i>
                            </div>
                            <span class="step-label">Property Type</span>
                        </div>
                        <div class="progress-step" data-step="2">
                            <div class="step-circle">
                                <span class="step-number">2</span>
                                <i class="bi bi-check-lg step-check"></i>
                            </div>
                            <span class="step-label">Rooms</span>
                        </div>
                        <div class="progress-step" data-step="3">
                            <div class="step-circle">
                                <span class="step-number">3</span>
                                <i class="bi bi-check-lg step-check"></i>
                            </div>
                            <span class="step-label">Service Type</span>
                        </div>
                        <div class="progress-step" data-step="4">
                            <div class="step-circle">
                                <span class="step-number">4</span>
                                <i class="bi bi-check-lg step-check"></i>
                            </div>
                            <span class="step-label">Confirm</span>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Booking Form Card -->
                    <div class="col-lg-7" data-aos="fade-up" data-aos-delay="200">
                        <div class="booking-card">
                            <!-- Step 1: Property Type -->
                            <div class="booking-step active" id="step1">
                                <div class="step-header">
                                    <h3 class="step-title">
                                        <i class="bi bi-building me-2 text-primary"></i>Select Property Type
                                    </h3>
                                    <p class="step-subtitle text-muted">What type of property do you need cleaned?</p>
                                </div>
                                <div class="step-content">
                                    <div class="property-options" id="propertyOptions">
                                        <div class="loading-placeholder">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p class="mt-2 text-muted">Loading options...</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-footer d-flex justify-content-end">
                                    <button class="btn btn-primary btn-next" id="btnStep1Next" disabled>
                                        Continue <i class="bi bi-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 2: Rooms -->
                            <div class="booking-step" id="step2">
                                <div class="step-header">
                                    <h3 class="step-title">
                                        <i class="bi bi-door-open me-2 text-primary"></i>Select Number of Rooms
                                    </h3>
                                    <p class="step-subtitle text-muted">How many rooms does your property have?</p>
                                </div>
                                <div class="step-content">
                                    <div class="room-options" id="roomOptions"></div>
                                </div>
                                <div class="step-footer d-flex justify-content-between">
                                    <button class="btn btn-outline-secondary btn-prev" id="btnStep2Prev">
                                        <i class="bi bi-arrow-left me-2"></i>Back
                                    </button>
                                    <button class="btn btn-primary btn-next" id="btnStep2Next" disabled>
                                        Continue <i class="bi bi-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 3: Service Type -->
                            <div class="booking-step" id="step3">
                                <div class="step-header">
                                    <h3 class="step-title">
                                        <i class="bi bi-stars me-2 text-primary"></i>Select Service Type
                                    </h3>
                                    <p class="step-subtitle text-muted">Choose the cleaning service you need</p>
                                </div>
                                <div class="step-content">
                                    <div class="service-options" id="serviceOptions"></div>
                                </div>
                                <div class="step-footer d-flex justify-content-between">
                                    <button class="btn btn-outline-secondary btn-prev" id="btnStep3Prev">
                                        <i class="bi bi-arrow-left me-2"></i>Back
                                    </button>
                                    <button class="btn btn-primary btn-next" id="btnStep3Next" disabled>
                                        Continue <i class="bi bi-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 4: Contact & Confirm -->
                            <div class="booking-step" id="step4">
                                <div class="step-header">
                                    <h3 class="step-title">
                                        <i class="bi bi-person-check me-2 text-primary"></i>Contact Information
                                    </h3>
                                    <p class="step-subtitle text-muted">Please provide your contact details</p>
                                </div>
                                <div class="step-content">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="contactName" placeholder="Your Name" required>
                                                <label for="contactName"><i class="bi bi-person me-2"></i>Full Name</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="tel" class="form-control" id="contactPhone" placeholder="Phone" required>
                                                <label for="contactPhone"><i class="bi bi-telephone me-2"></i>Phone Number</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <input type="email" class="form-control" id="contactEmail" placeholder="Email" required>
                                                <label for="contactEmail"><i class="bi bi-envelope me-2"></i>Email Address</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="contactAddress" placeholder="Address" required>
                                                <label for="contactAddress"><i class="bi bi-geo-alt me-2"></i>Service Address</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <textarea class="form-control" id="additionalInfo" placeholder="Notes" style="height: 100px"></textarea>
                                                <label for="additionalInfo"><i class="bi bi-chat-text me-2"></i>Additional Notes (Optional)</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="step-footer d-flex justify-content-between">
                                    <button class="btn btn-outline-secondary btn-prev" id="btnStep4Prev">
                                        <i class="bi bi-arrow-left me-2"></i>Back
                                    </button>
                                    <button class="btn btn-success btn-confirm" id="btnConfirm">
                                        <i class="bi bi-check-circle me-2"></i>Confirm Booking
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Summary Card -->
                    <div class="col-lg-5" data-aos="fade-up" data-aos-delay="300">
                        <div class="summary-card">
                            <div class="summary-header">
                                <h4 class="summary-title">
                                    <i class="bi bi-receipt me-2"></i>Booking Summary
                                </h4>
                            </div>
                            <div class="summary-body">
                                <ul class="summary-list" id="summaryList">
                                    <li class="summary-item" id="summaryProperty">
                                        <span class="item-label"><i class="bi bi-building me-2"></i>Property Type</span>
                                        <span class="item-value text-muted">Not selected</span>
                                    </li>
                                    <li class="summary-item" id="summaryRooms">
                                        <span class="item-label"><i class="bi bi-door-open me-2"></i>Rooms</span>
                                        <span class="item-value text-muted">Not selected</span>
                                    </li>
                                    <li class="summary-item" id="summaryService">
                                        <span class="item-label"><i class="bi bi-stars me-2"></i>Service Type</span>
                                        <span class="item-value text-muted">Not selected</span>
                                    </li>
                                </ul>
                                <hr class="my-3">
                                <div class="summary-total d-flex justify-content-between align-items-center" id="summaryTotal">
                                    <span class="total-label fw-bold">Estimated Total</span>
                                    <span class="total-value fs-4 fw-bold text-primary">$0.00</span>
                                </div>
                            </div>
                            <div class="summary-footer">
                                <div class="guarantee-badge">
                                    <i class="bi bi-shield-check text-success me-2"></i>
                                    <span>100% Satisfaction Guarantee</span>
                                </div>
                            </div>
                        </div>

                        <!-- Trust Badges -->
                        <div class="trust-badges mt-4">
                            <div class="row g-3 text-center">
                                <div class="col-4">
                                    <div class="trust-item">
                                        <i class="bi bi-award text-primary fs-4"></i>
                                        <small class="d-block text-muted">Licensed</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="trust-item">
                                        <i class="bi bi-patch-check text-primary fs-4"></i>
                                        <small class="d-block text-muted">Insured</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="trust-item">
                                        <i class="bi bi-people text-primary fs-4"></i>
                                        <small class="d-block text-muted">Vetted Staff</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            // State Management
            let currentStep = 1;
            let selectedProperty = null;
            let selectedRoom = null;
            let selectedService = null;
            let servicePrice = 0;

            // Initialize
            loadPropertyTypes();

            // Load Property Types
            function loadPropertyTypes() {
                $.get('/Booking/GetAllCleaningPlace', function(data) {
                    let html = '';
                    if (data.cleaningPlaces && data.cleaningPlaces.length > 0) {
                        data.cleaningPlaces.forEach(function(item) {
                            // DTO returns: id, title (from ComboBoxOutPutDto)
                            const itemId = item.id || item.value || item.Id;
                            const itemName = item.title || item.text || item.Title || item.name || item.Name || '';
                            html += `
                                <div class="option-card" data-id="${itemId}" data-name="${itemName}">
                                    <div class="option-icon">
                                        <i class="bi ${getPropertyIcon(itemName)}"></i>
                                    </div>
                                    <div class="option-content">
                                        <h5 class="option-title">${itemName}</h5>
                                    </div>
                                    <div class="option-check">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        html = '<div class="alert alert-warning">No property types available</div>';
                    }
                    $('#propertyOptions').html(html);
                    bindOptionClicks('#propertyOptions');
                }).fail(function() {
                    $('#propertyOptions').html('<div class="alert alert-danger">Error loading property types. Please refresh the page.</div>');
                });
            }

            // Load Rooms by Property Type
            function loadRooms(propertyId) {
                $('#roomOptions').html('<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>');
                $.get('/Booking/GetRoomsByCleaningPlaceId', { id: propertyId }, function(data) {
                    let html = '';
                    if (data.cleaningPlaceRooms && data.cleaningPlaceRooms.length > 0) {
                        data.cleaningPlaceRooms.forEach(function(item) {
                            // DTO returns: id, title (from ComboBoxOutPutDto)
                            const itemId = item.id || item.value || item.Id;
                            const itemName = item.title || item.text || item.Title || item.name || item.Name || '';
                            html += `
                                <div class="option-card" data-id="${itemId}" data-name="${itemName}">
                                    <div class="option-icon">
                                        <i class="bi bi-door-open"></i>
                                    </div>
                                    <div class="option-content">
                                        <h5 class="option-title">${itemName}</h5>
                                    </div>
                                    <div class="option-check">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        html = '<div class="alert alert-warning">No room options available for this property type</div>';
                    }
                    $('#roomOptions').html(html);
                    bindOptionClicks('#roomOptions');
                }).fail(function() {
                    $('#roomOptions').html('<div class="alert alert-danger">Error loading rooms</div>');
                });
            }

            // Load Service Types
            function loadServiceTypes(roomId) {
                $('#serviceOptions').html('<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>');
                $.get('/Booking/GetServiceTypeByPlaceRoomsId', { id: roomId }, function(data) {
                    let html = '';
                    if (data.cleaningPlaceRooms && data.cleaningPlaceRooms.length > 0) {
                        data.cleaningPlaceRooms.forEach(function(item) {
                            // DTO returns: id, title, price (from ComboBoxOutPutDto)
                            const itemId = item.id || item.value || item.Id;
                            const itemName = item.title || item.text || item.Title || item.name || item.Name || '';
                            const itemPrice = item.price || item.Price || 0;
                            html += `
                                <div class="option-card service-card" data-id="${itemId}" data-name="${itemName}" data-price="${itemPrice}">
                                    <div class="option-icon">
                                        <i class="bi ${getServiceIcon(itemName)}"></i>
                                    </div>
                                    <div class="option-content">
                                        <h5 class="option-title">${itemName}</h5>
                                        <span class="option-price text-primary fw-bold">$${parseFloat(itemPrice).toFixed(2)}</span>
                                    </div>
                                    <div class="option-check">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        html = '<div class="alert alert-warning">No service types available for these rooms</div>';
                    }
                    $('#serviceOptions').html(html);
                    bindServiceClicks('#serviceOptions');
                }).fail(function() {
                    $('#serviceOptions').html('<div class="alert alert-danger">Error loading service types</div>');
                });
            }

            // Bind click events to option cards
            function bindOptionClicks(container) {
                $(container + ' .option-card').click(function() {
                    $(container + ' .option-card').removeClass('selected');
                    $(this).addClass('selected');
                    
                    if (container === '#propertyOptions') {
                        selectedProperty = { id: $(this).data('id'), name: $(this).data('name') };
                        $('#btnStep1Next').prop('disabled', false);
                        updateSummary('property', selectedProperty.name);
                    } else if (container === '#roomOptions') {
                        selectedRoom = { id: $(this).data('id'), name: $(this).data('name') };
                        $('#btnStep2Next').prop('disabled', false);
                        updateSummary('rooms', selectedRoom.name);
                    }
                });
            }

            // Bind click events to service cards
            function bindServiceClicks(container) {
                $(container + ' .option-card').click(function() {
                    $(container + ' .option-card').removeClass('selected');
                    $(this).addClass('selected');
                    
                    selectedService = {
                        id: $(this).data('id'),
                        name: $(this).data('name'),
                        price: parseFloat($(this).data('price')) || 0
                    };
                    servicePrice = selectedService.price;
                    $('#btnStep3Next').prop('disabled', false);
                    updateSummary('service', selectedService.name, selectedService.price);
                });
            }

            // Update Summary
            function updateSummary(type, value, price) {
                if (type === 'property') {
                    $('#summaryProperty .item-value').removeClass('text-muted').text(value);
                } else if (type === 'rooms') {
                    $('#summaryRooms .item-value').removeClass('text-muted').text(value);
                } else if (type === 'service') {
                    $('#summaryService .item-value').removeClass('text-muted').html(`${value} <br><small class="text-primary">$${price.toFixed(2)}</small>`);
                    $('#summaryTotal .total-value').text('$' + price.toFixed(2));
                }
            }

            // Get icon based on property type name
            function getPropertyIcon(name) {
                const lower = name.toLowerCase();
                if (lower.includes('house') || lower.includes('casa')) return 'bi-house-door';
                if (lower.includes('apartment') || lower.includes('depart')) return 'bi-building';
                if (lower.includes('office') || lower.includes('oficina')) return 'bi-buildings';
                if (lower.includes('condo')) return 'bi-building';
                if (lower.includes('studio')) return 'bi-house';
                return 'bi-house-door';
            }

            // Get icon based on service type name
            function getServiceIcon(name) {
                const lower = name.toLowerCase();
                if (lower.includes('deep') || lower.includes('profund')) return 'bi-stars';
                if (lower.includes('regular') || lower.includes('standard')) return 'bi-check2-circle';
                if (lower.includes('move') || lower.includes('mudanza')) return 'bi-truck';
                if (lower.includes('premium')) return 'bi-gem';
                return 'bi-sparkles';
            }

            // Navigate to step
            function goToStep(step) {
                currentStep = step;
                $('.booking-step').removeClass('active');
                $('#step' + step).addClass('active');
                updateProgress(step);
            }

            // Update progress bar and steps
            function updateProgress(step) {
                const progress = ((step - 1) / 3) * 100;
                $('#progressBar').css('width', progress + '%');
                
                $('.progress-step').each(function() {
                    const stepNum = $(this).data('step');
                    $(this).removeClass('active completed');
                    if (stepNum < step) {
                        $(this).addClass('completed');
                    } else if (stepNum === step) {
                        $(this).addClass('active');
                    }
                });
            }

            // Navigation button handlers
            $('#btnStep1Next').click(function() {
                if (selectedProperty) { loadRooms(selectedProperty.id); goToStep(2); }
            });
            $('#btnStep2Prev').click(function() { goToStep(1); });
            $('#btnStep2Next').click(function() {
                if (selectedRoom) { loadServiceTypes(selectedRoom.id); goToStep(3); }
            });
            $('#btnStep3Prev').click(function() { goToStep(2); });
            $('#btnStep3Next').click(function() { if (selectedService) { goToStep(4); } });
            $('#btnStep4Prev').click(function() { goToStep(3); });

            // Confirm Booking
            $('#btnConfirm').click(function() {
                const name = $('#contactName').val().trim();
                const phone = $('#contactPhone').val().trim();
                const email = $('#contactEmail').val().trim();
                const address = $('#contactAddress').val().trim();
                const additionalInfo = $('#additionalInfo').val().trim();

                if (!name || !phone || !email || !address) {
                    Swal.fire({ icon: 'warning', title: 'Incomplete Information', text: 'Please fill in all required fields', confirmButtonColor: '#2563eb' });
                    return;
                }

                // Save contact info to cookies
                setCookie('name', name, 1);
                setCookie('email', email, 1);
                setCookie('phone', phone, 1);
                setCookie('address', address, 1);
                setCookie('additionalInfo', additionalInfo, 1);

                const bookData = {
                    CleaningPlaceId: selectedProperty.id,
                    CleaningPlaceRoomId: selectedRoom.id,
                    ServiceTypeId: selectedService.id,
                    ContactInfo: { Name: name, Email: email, Phone: phone, Address: address, AdditionalServiceInfo: additionalInfo }
                };

                Swal.fire({ title: 'Processing...', text: 'Creating your booking', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

                $.ajax({
                    url: '/Booking/Book',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(bookData),
                    success: function(response) {
                        if (response.cartItemId) {
                            Swal.fire({ icon: 'success', title: 'Booking Created!', text: 'Redirecting to schedule your appointment...', showConfirmButton: false, timer: 1500 }).then(function() {
                                window.location.href = '/Booking/ProcessToCheckOut?id=' + response.cartItemId;
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'Could not create booking. Please try again.', confirmButtonColor: '#2563eb' });
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'An error occurred. Please try again.';
                        if (xhr.responseJSON && xhr.responseJSON.error) { errorMsg = xhr.responseJSON.error; }
                        Swal.fire({ icon: 'error', title: 'Error', text: errorMsg, confirmButtonColor: '#2563eb' });
                    }
                });
            });

            function setCookie(name, value, days) {
                let expires = '';
                if (days) {
                    const date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = '; expires=' + date.toUTCString();
                }
                document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/';
            }
        });
    </script>

    <style>
        .booking-hero { background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(56, 189, 248, 0.05) 100%); }
        .booking-progress { position: relative; padding: 0 2rem; }
        .progress-track { position: absolute; top: 20px; left: 0; right: 0; height: 4px; background: #e2e8f0; border-radius: 2px; z-index: 0; }
        .progress-bar-fill { height: 100%; background: var(--primary-color); border-radius: 2px; transition: width 0.5s ease; width: 0%; }
        .progress-steps { position: relative; z-index: 1; }
        .progress-step { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
        .step-circle { width: 40px; height: 40px; border-radius: 50%; background: #fff; border: 3px solid #e2e8f0; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; }
        .step-number { font-weight: 600; color: #94a3b8; }
        .step-check { display: none; color: white; }
        .step-label { font-size: 0.875rem; color: #94a3b8; font-weight: 500; }
        .progress-step.active .step-circle { border-color: var(--primary-color); background: var(--primary-color); }
        .progress-step.active .step-number { color: white; }
        .progress-step.active .step-label { color: var(--primary-color); }
        .progress-step.completed .step-circle { border-color: var(--primary-color); background: var(--primary-color); }
        .progress-step.completed .step-number { display: none; }
        .progress-step.completed .step-check { display: block; }
        .progress-step.completed .step-label { color: var(--primary-color); }
        .booking-card { background: white; border-radius: 1rem; padding: 2rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); border: 1px solid rgba(0, 0, 0, 0.05); }
        .booking-step { display: none; }
        .booking-step.active { display: block; animation: fadeIn 0.3s ease; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .step-header { margin-bottom: 1.5rem; }
        .step-title { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.25rem; }
        .step-subtitle { font-size: 0.9rem; margin-bottom: 0; }
        .step-content { min-height: 250px; }
        .step-footer { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e2e8f0; }
        .option-card { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: #f8fafc; border: 2px solid transparent; border-radius: 0.75rem; cursor: pointer; transition: all 0.3s ease; margin-bottom: 0.75rem; }
        .option-card:hover { background: #f1f5f9; border-color: rgba(37, 99, 235, 0.3); }
        .option-card.selected { background: rgba(37, 99, 235, 0.05); border-color: var(--primary-color); }
        .option-icon { width: 48px; height: 48px; border-radius: 0.5rem; background: white; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: var(--primary-color); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06); }
        .option-content { flex: 1; }
