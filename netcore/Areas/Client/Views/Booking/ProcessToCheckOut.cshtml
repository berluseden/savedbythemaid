@using JempSoft.Applications.Book.Dto
@model OrderToCheckOutDto
@{
    ViewData["Title"] = "Schedule Appointment";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- Appointment Hero -->
<section class="appointment-hero py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center" data-aos="fade-up">
                <span class="badge bg-success-subtle text-success mb-3 px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle me-2"></i>Service Selected
                </span>
                <h1 class="display-5 fw-bold mb-3">Schedule Your Appointment</h1>
                <p class="lead text-muted mb-0">Choose your preferred date and time for the cleaning service</p>
            </div>
        </div>
    </div>
</section>

<!-- Appointment Form -->
<section class="appointment-section pb-5">
    <div class="container">
        <div class="row justify-content-center g-4">
            <!-- Service Details Card -->
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="service-details-card">
                    <div class="card-header-custom">
                        <h4><i class="bi bi-bag-check me-2"></i>Your Service</h4>
                    </div>
                    <div class="card-body-custom">
                        <div class="service-info">
                            <div class="info-item">
                                <span class="info-label">Property Type</span>
                                <span class="info-value">@Model.CleaningPlace_Title</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Rooms</span>
                                <span class="info-value">@Model.CleaningPlaceRoom_Title</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Service Type</span>
                                <span class="info-value">@Model.ServiceType_Title</span>
                            </div>
                            <hr class="my-3">
                            <div class="price-info d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Base Price</span>
                                <span class="fs-4 fw-bold text-primary">$@Convert.ToDecimal(Model.ServiceType_Price).ToString("F2")</span>
                            </div>
                        </div>
                        
                        @if (Model.AdditionalServiceTypes != null && Model.AdditionalServiceTypes.Any())
                        {
                            <hr class="my-3">
                            <h6 class="mb-3"><i class="bi bi-plus-circle me-2"></i>Add Extra Services</h6>
                            <div class="additional-services">
                                @foreach (var item in Model.AdditionalServiceTypes)
                                {
                                    <div class="additional-service-item">
                                        <div class="form-check">
                                            <input class="form-check-input additional-service-check" 
                                                   type="checkbox" 
                                                   data-price="@item.Price" 
                                                   value="@item.AdditionalServiceTypeId" 
                                                   id="addon_@item.AdditionalServiceTypeId">
                                            <label class="form-check-label" for="addon_@item.AdditionalServiceTypeId">
                                                @item.Title
                                            </label>
                                        </div>
                                        <span class="addon-price">+$@item.Price.ToString("F2")</span>
                                    </div>
                                }
                            </div>
                        }
                        
                        <hr class="my-3">
                        <div class="total-price d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Total</span>
                            <span class="fs-3 fw-bold text-success" id="totalPrice">$@Convert.ToDecimal(Model.ServiceType_Price).ToString("F2")</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Date & Time Selection -->
            <div class="col-lg-5" data-aos="fade-up" data-aos-delay="200">
                <div class="appointment-card">
                    <div class="card-header-custom">
                        <h4><i class="bi bi-calendar-event me-2"></i>Select Date & Time</h4>
                    </div>
                    <div class="card-body-custom">
                        <input type="hidden" id="cartItemId" value="@Model.CartItemId" />
                        <input type="hidden" id="basePrice" value="@Model.ServiceType_Price" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>Preferred Date
                            </label>
                            <input type="date" 
                                   id="dateOfService" 
                                   class="form-control form-control-lg"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" 
                                   max="@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")" />
                            <small class="text-muted">Select a date within the next year</small>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-clock me-2 text-primary"></i>Preferred Time
                            </label>
                            <input type="time" 
                                   id="timeOfService" 
                                   class="form-control form-control-lg"
                                   step="1800"
                                   disabled />
                            <small class="text-muted">Available slots shown after selecting date</small>
                        </div>
                        
                        <div class="availability-info mb-4" id="availabilityInfo" style="display: none;">
                            <div class="alert alert-info d-flex align-items-center">
                                <i class="bi bi-info-circle me-2 fs-4"></i>
                                <div>
                                    <strong>Available Staff:</strong> 
                                    <span id="availableMaidsText">0</span> cleaning professional(s) available
                                </div>
                            </div>
                        </div>
                        
                        <div class="no-availability-info" id="noAvailabilityInfo" style="display: none;">
                            <div class="alert alert-warning d-flex align-items-center">
                                <i class="bi bi-exclamation-triangle me-2 fs-4"></i>
                                <div>No staff available for this date. Please try another date.</div>
                            </div>
                        </div>
                        
                        <button class="btn btn-primary btn-lg w-100" id="btnCheckOut" disabled>
                            <i class="bi bi-cart-check me-2"></i>Add to Cart & Checkout
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Help Card -->
            <div class="col-lg-3" data-aos="fade-up" data-aos-delay="300">
                <div class="help-card">
                    <div class="card-header-custom">
                        <h5><i class="bi bi-question-circle me-2"></i>Need Help?</h5>
                    </div>
                    <div class="card-body-custom">
                        <div class="help-item mb-4">
                            <i class="bi bi-telephone text-primary fs-4 mb-2"></i>
                            <h6>Call Us</h6>
                            <p class="text-muted small mb-0">(305) 555-0123</p>
                        </div>
                        <div class="help-item mb-4">
                            <i class="bi bi-chat-dots text-primary fs-4 mb-2"></i>
                            <h6>Live Chat</h6>
                            <p class="text-muted small mb-0">Available 24/7</p>
                        </div>
                        <div class="help-item">
                            <i class="bi bi-envelope text-primary fs-4 mb-2"></i>
                            <h6>Email</h6>
                            <p class="text-muted small mb-0">support@ecomaid911.com</p>
                        </div>
                    </div>
                </div>
                
                <!-- Guarantees -->
                <div class="guarantees-card mt-4">
                    <div class="guarantee-item">
                        <i class="bi bi-shield-check text-success"></i>
                        <span>100% Satisfaction Guarantee</span>
                    </div>
                    <div class="guarantee-item">
                        <i class="bi bi-award text-success"></i>
                        <span>Licensed & Insured</span>
                    </div>
                    <div class="guarantee-item">
                        <i class="bi bi-lock text-success"></i>
                        <span>Secure Booking</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            const cartItemId = $('#cartItemId').val();
            const basePrice = parseFloat($('#basePrice').val()) || 0;
            let additionalTotal = 0;
            let selectedDate = { year: 0, month: 0, day: 0 };
            let selectedTime = { hour: 0, minute: 0 };
            let availableMaids = 0;

            // Date change handler
            $('#dateOfService').on('change', function() {
                const dateValue = $(this).val();
                if (!dateValue) return;

                const dateArr = dateValue.split('-');
                selectedDate = {
                    year: parseInt(dateArr[0]),
                    month: parseInt(dateArr[1]),
                    day: parseInt(dateArr[2])
                };

                $('#timeOfService').val('').prop('disabled', true);
                $('#btnCheckOut').prop('disabled', true);
                $('#availabilityInfo').hide();
                $('#noAvailabilityInfo').hide();

                checkAvailability();
            });

            // Time change handler
            $('#timeOfService').on('change', function() {
                const timeValue = $(this).val();
                if (!timeValue) return;

                const timeArr = timeValue.split(':');
                selectedTime = {
                    hour: parseInt(timeArr[0]),
                    minute: parseInt(timeArr[1])
                };

                if (availableMaids > 0) {
                    $('#btnCheckOut').prop('disabled', false);
                }
            });

            // Check availability
            function checkAvailability() {
                $.get('/Booking/GetAvaliableMaidByDay', {
                    year: selectedDate.year,
                    month: selectedDate.month,
                    day: selectedDate.day
                }, function(data) {
                    availableMaids = data.avaliableMaids || 0;
                    
                    if (availableMaids > 0) {
                        $('#availableMaidsText').text(availableMaids);
                        $('#availabilityInfo').show();
                        $('#noAvailabilityInfo').hide();
                        $('#timeOfService').prop('disabled', false);
                    } else {
                        $('#availabilityInfo').hide();
                        $('#noAvailabilityInfo').show();
                        $('#timeOfService').prop('disabled', true);
                    }
                }).fail(function() {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Could not check availability. Please try again.', confirmButtonColor: '#2563eb' });
                });
            }

            // Additional services handler
            $('.additional-service-check').on('change', function() {
                calculateTotal();
            });

            function calculateTotal() {
                additionalTotal = 0;
                $('.additional-service-check:checked').each(function() {
                    additionalTotal += parseFloat($(this).data('price')) || 0;
                });
                const total = basePrice + additionalTotal;
                $('#totalPrice').text('$' + total.toFixed(2));
            }

            // Checkout handler
            $('#btnCheckOut').on('click', function() {
                if (!selectedDate.year || !selectedTime.hour === undefined) {
                    Swal.fire({ icon: 'warning', title: 'Missing Information', text: 'Please select date and time', confirmButtonColor: '#2563eb' });
                    return;
                }

                const additionalServices = [];
                $('.additional-service-check:checked').each(function() {
                    additionalServices.push(parseInt($(this).val()));
                });

                const contactInfo = {
                    Name: getCookie('name') || '',
                    Email: getCookie('email') || '',
                    Phone: getCookie('phone') || '',
                    Address: getCookie('address') || '',
                    AdditionalServiceInfo: getCookie('additionalInfo') || ''
                };

                Swal.fire({ title: 'Processing...', text: 'Adding to cart', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

                $.ajax({
                    url: '/Booking/AddToCart',
                    method: 'POST',
                    data: {
                        cartItemId: parseInt(cartItemId),
                        day: selectedDate.day,
                        month: selectedDate.month,
                        year: selectedDate.year,
                        hour: selectedTime.hour,
                        minute: selectedTime.minute,
                        aditionalServices: additionalServices,
                        contactInfo: contactInfo
                    },
                    success: function(response) {
                        if (response.isAdded) {
                            Swal.fire({ icon: 'success', title: 'Added to Cart!', text: 'Redirecting to your cart...', showConfirmButton: false, timer: 1500 }).then(function() {
                                window.location.href = '/Cart/Index';
                            });
                        } else if (!response.isAuthenticated) {
                            Swal.fire({ icon: 'info', title: 'Login Required', text: 'Please login to complete your booking', confirmButtonColor: '#2563eb' }).then(function() {
                                window.location.href = '/Account/Login?returnUrl=/Booking/ProcessToCheckOut?id=' + cartItemId;
                            });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'Could not add to cart. Please try again.', confirmButtonColor: '#2563eb' });
                        }
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred. Please try again.', confirmButtonColor: '#2563eb' });
                    }
                });
            });

            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
                return '';
            }
        });
    </script>

    <style>
        .appointment-hero { background: linear-gradient(135deg, rgba(34, 197, 94, 0.05) 0%, rgba(37, 99, 235, 0.05) 100%); }
        .service-details-card, .appointment-card, .help-card { background: white; border-radius: 1rem; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); }
        .card-header-custom { background: linear-gradient(135deg, var(--primary-color) 0%, #1e40af 100%); color: white; padding: 1.25rem 1.5rem; }
        .card-header-custom h4, .card-header-custom h5 { margin: 0; font-size: 1.1rem; }
        .card-body-custom { padding: 1.5rem; }
        .info-item { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; }
        .info-label { color: #64748b; }
        .info-value { font-weight: 500; }
        .additional-service-item { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; }
        .addon-price { font-weight: 600; color: var(--primary-color); font-size: 0.9rem; }
        .help-item { text-align: center; }
        .guarantees-card { background: white; border-radius: 1rem; padding: 1.25rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); }
        .guarantee-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0; font-size: 0.9rem; }
        .form-control-lg { border-radius: 0.75rem; }
        .form-control:focus { border-color: var(--primary-color); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
    </style>
}

