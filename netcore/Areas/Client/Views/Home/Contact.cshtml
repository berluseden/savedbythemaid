@{
    ViewData["Title"] = "Contact Us";
}

<!-- Contact Header -->
<section class="page-header py-5" style="padding-top: 120px;">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="section-badge">📞 Get In Touch</span>
            <h1 class="section-title">
                Contact <span class="highlight">Us</span>
            </h1>
            <p class="section-subtitle">
                We'd love to hear from you. Reach out anytime!
            </p>
        </div>
    </div>
</section>

<!-- Contact Content -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <!-- Contact Form -->
            <div class="col-lg-7" data-aos="fade-right">
                <div class="contact-form-card p-4 p-lg-5 rounded-4 bg-white shadow-lg">
                    <h3 class="mb-4">Send Us a Message</h3>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Your Name</label>
                                <input type="text" class="form-control form-control-lg" placeholder="John Doe" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address</label>
                                <input type="email" class="form-control form-control-lg" placeholder="john@example.com" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" class="form-control form-control-lg" placeholder="+1 (555) 000-0000">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subject</label>
                                <select class="form-select form-select-lg">
                                    <option selected>Select a topic</option>
                                    <option>General Inquiry</option>
                                    <option>Booking Question</option>
                                    <option>Service Information</option>
                                    <option>Feedback</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="5" placeholder="How can we help you?"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-hero-primary w-100">
                                    <i class="bi bi-send me-2"></i> Send Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Contact Info -->
            <div class="col-lg-5" data-aos="fade-left">
                <div class="contact-info-card p-4 rounded-4 mb-4" style="background: var(--gradient-primary); color: white;">
                    <h4 class="mb-4" style="color: white;">Contact Information</h4>
                    
                    <div class="contact-item d-flex gap-3 mb-4">
                        <div class="contact-icon">
                            <i class="bi bi-geo-alt-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1" style="color: white;">Our Address</h6>
                            <p class="mb-0" style="opacity: 0.9;">123 Main Street<br>Miami, FL 33101</p>
                        </div>
                    </div>
                    
                    <div class="contact-item d-flex gap-3 mb-4">
                        <div class="contact-icon">
                            <i class="bi bi-telephone-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1" style="color: white;">Phone</h6>
                            <p class="mb-0" style="opacity: 0.9;">+1 (305) 555-0123</p>
                        </div>
                    </div>
                    
                    <div class="contact-item d-flex gap-3 mb-4">
                        <div class="contact-icon">
                            <i class="bi bi-envelope-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1" style="color: white;">Email</h6>
                            <p class="mb-0" style="opacity: 0.9;">info@ecomaid911.com</p>
                        </div>
                    </div>
                    
                    <div class="contact-item d-flex gap-3">
                        <div class="contact-icon">
                            <i class="bi bi-clock-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1" style="color: white;">Business Hours</h6>
                            <p class="mb-0" style="opacity: 0.9;">Mon - Sat: 7:00 AM - 8:00 PM<br>Sunday: Closed</p>
                        </div>
                    </div>
                </div>
                
                <!-- Social Links -->
                <div class="social-links-card p-4 rounded-4 bg-white shadow-sm text-center">
                    <h5 class="mb-3">Follow Us</h5>
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="#" class="social-link"><i class="bi bi-facebook fs-4"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-instagram fs-4"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-twitter-x fs-4"></i></a>
                        <a href="#" class="social-link"><i class="bi bi-whatsapp fs-4"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-4" data-aos="fade-up">
            <h3>Find Us On The Map</h3>
        </div>
        <div class="ratio ratio-21x9 rounded-4 overflow-hidden shadow" data-aos="fade-up">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d114964.53925916665!2d-80.29949880000001!3d25.782390699999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9b0a20ec8c111%3A0xff96f271ddad4f65!2sMiami%2C%20FL!5e0!3m2!1sen!2sus!4v1704500000000!5m2!1sen!2sus" 
                    style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
</section>

@section Styles {
<style>
    .contact-form-card .form-control,
    .contact-form-card .form-select {
        border-radius: var(--radius-md);
        border: 2px solid #e5e7eb;
        transition: var(--transition-base);
    }
    
    .contact-form-card .form-control:focus,
    .contact-form-card .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }
    
    .contact-icon {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .social-link {
        width: 50px;
        height: 50px;
        background: var(--gradient-clean);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--brand-primary);
        transition: var(--transition-base);
    }
    
    .social-link:hover {
        background: var(--gradient-primary);
        color: white;
        transform: translateY(-3px);
    }
</style>
}
