@{
    ViewData["Title"] = "About Us";
}

<!-- About Header -->
<section class="page-header py-5" style="padding-top: 120px;">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="section-badge">👋 Who We Are</span>
            <h1 class="section-title">
                About <span class="highlight">ecoMaid 911</span>
            </h1>
            <p class="section-subtitle">
                Your trusted partner for professional cleaning services
            </p>
        </div>
    </div>
</section>

<!-- About Content -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <img src="~/img/about-team.jpg" alt="ecoMaid Team" class="img-fluid rounded-4 shadow-lg" 
                     onerror="this.src='https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=600&h=400&fit=crop'">
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <h2 class="mb-4">Cleaning Excellence Since 2015</h2>
                <p class="lead text-muted mb-4">
                    ecoMaid 911 was founded with a simple mission: to provide exceptional cleaning services that transform spaces and exceed expectations.
                </p>
                <p class="text-muted mb-4">
                    What started as a small family business has grown into a trusted name in professional cleaning across South Florida. We take pride in our attention to detail, eco-friendly practices, and commitment to customer satisfaction.
                </p>
                
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-box text-center p-3 rounded-3 bg-light">
                            <h3 class="text-primary mb-0">10+</h3>
                            <small class="text-muted">Years Experience</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box text-center p-3 rounded-3 bg-light">
                            <h3 class="text-primary mb-0">5000+</h3>
                            <small class="text-muted">Happy Clients</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box text-center p-3 rounded-3 bg-light">
                            <h3 class="text-primary mb-0">50+</h3>
                            <small class="text-muted">Team Members</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box text-center p-3 rounded-3 bg-light">
                            <h3 class="text-primary mb-0">100%</h3>
                            <small class="text-muted">Satisfaction</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Values -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="section-badge">💎 Our Values</span>
            <h2 class="section-title">What Drives Us</h2>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="value-card text-center p-4 h-100 bg-white rounded-4 shadow-sm">
                    <div class="value-icon mb-3">
                        <i class="bi bi-heart-fill text-danger fs-1"></i>
                    </div>
                    <h4>Passion</h4>
                    <p class="text-muted">We love what we do, and it shows in every sparkling surface we leave behind.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="value-card text-center p-4 h-100 bg-white rounded-4 shadow-sm">
                    <div class="value-icon mb-3">
                        <i class="bi bi-hand-thumbs-up-fill text-primary fs-1"></i>
                    </div>
                    <h4>Integrity</h4>
                    <p class="text-muted">Honesty and transparency are the foundation of our relationships with clients.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="value-card text-center p-4 h-100 bg-white rounded-4 shadow-sm">
                    <div class="value-icon mb-3">
                        <i class="bi bi-leaf-fill text-success fs-1"></i>
                    </div>
                    <h4>Eco-Friendly</h4>
                    <p class="text-muted">We use environmentally responsible products that are safe for your family and pets.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="text-center p-5 rounded-4" style="background: var(--gradient-primary); color: white;">
            <h2 class="mb-3" style="color: white;">Ready to Experience the ecoMaid Difference?</h2>
            <p class="lead mb-4" style="opacity: 0.9;">Let us take care of the cleaning while you focus on what matters most</p>
            <a href="@Url.Action("Schedule", "Booking")" class="btn btn-light btn-lg px-5 fw-bold">
                <i class="bi bi-calendar-plus me-2"></i> Book Now
            </a>
        </div>
    </div>
</section>
