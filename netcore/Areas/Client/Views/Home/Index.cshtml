                <a href="@Url.Action("Schedule", "Booking")" class="btn btn-cta-light">
                    <i class="bi bi-calendar-check me-2"></i>Schedule Your Cleaning
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    $(document).ready(function() {
        // Load cleaning places for the dropdown
        $.ajax({
            url: '@Url.Action("GetAllCleaningPlace", "Booking")',
            type: 'GET',
            success: function(response) {
                if (response && response.Result) {
                    var select = $('#cleaningPlaceSelect');
                    $.each(response.Result, function(i, item) {
                        select.append($('<option></option>').val(item.Id).text(item.Title));
                    });
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading cleaning places:', error);
            }
        });
        
        // Quick contact form submission
        $('#quickContactForm').on('submit', function(e) {
            e.preventDefault();
            Swal.fire({
                icon: 'success',
                title: 'Request Sent!',
                text: 'We will contact you shortly.',
                confirmButtonColor: '#2563eb'
            });
        });
    });
</script>
}
