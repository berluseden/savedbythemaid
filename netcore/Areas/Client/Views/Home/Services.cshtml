@{
    ViewData["Title"] = "Our Services";
}

<!-- Services Header -->
<section class="page-header py-5" style="padding-top: 120px;">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="section-badge">✨ What We Offer</span>
            <h1 class="section-title">
                Our <span class="highlight">Services</span>
            </h1>
            <p class="section-subtitle">
                Professional cleaning solutions tailored to your needs
            </p>
        </div>
    </div>
</section>

<!-- Services Grid -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Service 1 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="service-card-modern h-100">
                    <div class="service-icon-box">
                        <i class="bi bi-building"></i>
                    </div>
                    <h4>Office & Commercial Cleaning</h4>
                    <p class="text-muted">Keep your workspace pristine and professional. We provide thorough cleaning for offices, retail spaces, and commercial buildings.</p>
                    <ul class="service-features">
                        <li><i class="bi bi-check-circle-fill text-success"></i> Daily/Weekly maintenance</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Restroom sanitation</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Floor care & vacuuming</li>
                    </ul>
                    <a href="@Url.Action("Schedule", "Booking")" class="btn-service-cta">
                        Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Service 2 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="service-card-modern h-100">
                    <div class="service-icon-box">
                        <i class="bi bi-house-door"></i>
                    </div>
                    <h4>Residential Cleaning</h4>
                    <p class="text-muted">Transform your home into a spotless sanctuary. Our team handles everything from routine cleaning to deep sanitization.</p>
                    <ul class="service-features">
                        <li><i class="bi bi-check-circle-fill text-success"></i> Kitchen & bathroom deep clean</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Bedroom & living areas</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Dusting & organizing</li>
                    </ul>
                    <a href="@Url.Action("Schedule", "Booking")" class="btn-service-cta">
                        Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Service 3 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="service-card-modern h-100">
                    <div class="service-icon-box">
                        <i class="bi bi-window"></i>
                    </div>
                    <h4>Window Cleaning</h4>
                    <p class="text-muted">Crystal clear windows that let the sunshine in. Professional window cleaning for homes and businesses.</p>
                    <ul class="service-features">
                        <li><i class="bi bi-check-circle-fill text-success"></i> Interior & exterior windows</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Streak-free finish</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Screen cleaning included</li>
                    </ul>
                    <a href="@Url.Action("Schedule", "Booking")" class="btn-service-cta">
                        Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Service 4 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                <div class="service-card-modern h-100">
                    <div class="service-icon-box">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h4>Deep Cleaning</h4>
                    <p class="text-muted">Intensive cleaning that reaches every corner. Perfect for seasonal cleanings or special occasions.</p>
                    <ul class="service-features">
                        <li><i class="bi bi-check-circle-fill text-success"></i> Appliance deep clean</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Baseboards & trim</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Cabinet interiors</li>
                    </ul>
                    <a href="@Url.Action("Schedule", "Booking")" class="btn-service-cta">
                        Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Service 5 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="500">
                <div class="service-card-modern h-100">
                    <div class="service-icon-box">
                        <i class="bi bi-hammer"></i>
                    </div>
                    <h4>Post-Construction Cleaning</h4>
                    <p class="text-muted">Remove dust, debris, and residue after renovations. We make your newly built or renovated space move-in ready.</p>
                    <ul class="service-features">
                        <li><i class="bi bi-check-circle-fill text-success"></i> Dust & debris removal</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Surface polishing</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Final inspection clean</li>
                    </ul>
                    <a href="@Url.Action("Schedule", "Booking")" class="btn-service-cta">
                        Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Service 6 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="600">
                <div class="service-card-modern h-100">
                    <div class="service-icon-box">
                        <i class="bi bi-truck"></i>
                    </div>
                    <h4>Move In/Out Cleaning</h4>
                    <p class="text-muted">Start fresh in your new home or leave your old place spotless. Comprehensive cleaning for moving transitions.</p>
                    <ul class="service-features">
                        <li><i class="bi bi-check-circle-fill text-success"></i> Full property cleaning</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Appliance cleaning</li>
                        <li><i class="bi bi-check-circle-fill text-success"></i> Carpet & floor care</li>
                    </ul>
                    <a href="@Url.Action("Schedule", "Booking")" class="btn-service-cta">
                        Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="section-badge">💪 Why Choose Us</span>
            <h2 class="section-title">The ecoMaid Difference</h2>
        </div>
        
        <div class="row g-4">
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-box text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5>Insured & Bonded</h5>
                    <p class="text-muted small">Fully insured for your peace of mind</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-box text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5>Trained Staff</h5>
                    <p class="text-muted small">Professional, vetted team members</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-box text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-leaf"></i>
                    </div>
                    <h5>Eco-Friendly</h5>
                    <p class="text-muted small">Green cleaning products used</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="400">
                <div class="feature-box text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-award"></i>
                    </div>
                    <h5>Satisfaction Guaranteed</h5>
                    <p class="text-muted small">100% satisfaction or we re-clean free</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5" data-aos="fade-up">
    <div class="container">
        <div class="cta-card text-center p-5 rounded-4">
            <h2 class="mb-3">Ready to Experience the Difference?</h2>
            <p class="lead mb-4 text-muted">Book your cleaning service today and enjoy a spotless space</p>
            <a href="@Url.Action("Schedule", "Booking")" class="btn-hero-primary">
                <i class="bi bi-calendar-plus me-2"></i> Schedule Your Cleaning
            </a>
        </div>
    </div>
</section>

@section Styles {
<style>
    .service-card-modern {
        background: white;
        border-radius: var(--radius-lg);
        padding: 2rem;
        box-shadow: var(--shadow-md);
        transition: var(--transition-base);
        border: 1px solid rgba(0,0,0,0.05);
    }
    
    .service-card-modern:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }
    
    .service-icon-box {
        width: 70px;
        height: 70px;
        background: var(--gradient-primary);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }
    
    .service-icon-box i {
        font-size: 2rem;
        color: white;
    }
    
    .service-card-modern h4 {
        color: var(--brand-secondary);
        margin-bottom: 1rem;
    }
    
    .service-features {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
    }
    
    .service-features li {
        padding: 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }
    
    .btn-service-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--brand-primary);
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition-base);
    }
    
    .btn-service-cta:hover {
        color: var(--brand-secondary);
        gap: 1rem;
    }
    
    .feature-box {
        background: white;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        transition: var(--transition-base);
    }
    
    .feature-box:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    
    .feature-icon {
        width: 60px;
        height: 60px;
        background: var(--gradient-clean);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }
    
    .feature-icon i {
        font-size: 1.5rem;
        color: var(--brand-primary);
    }
    
    .cta-card {
        background: var(--gradient-primary);
        color: white;
    }
    
    .cta-card h2 {
        color: white;
    }
    
    .cta-card .text-muted {
        color: rgba(255,255,255,0.8) !important;
    }
    
    .cta-card .btn-hero-primary {
        background: white;
        color: var(--brand-primary);
    }
    
    .cta-card .btn-hero-primary:hover {
        background: rgba(255,255,255,0.9);
    }
</style>
}
