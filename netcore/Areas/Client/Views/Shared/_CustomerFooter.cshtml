@* ============================================
   🦶 ecoMaid 911 - Footer
   Modern footer with gradient design - English
   ============================================ *@

<footer class="customer-footer">
    <div class="container">
        <div class="row g-5">
            <!-- Brand Column -->
            <div class="col-lg-4 col-md-6">
                <div class="footer-brand">
                    <img src="~/img/logo.png" alt="ecoMaid 911" height="50">
                </div>
                <p class="footer-description mt-3">
                    Professional cleaning services for homes and offices. 
                    Quality guaranteed, impeccable results.
                </p>
                <div class="footer-social">
                    <a href="#" title="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                </div>
            </div>
            
            <!-- Quick Links -->
            <div class="col-lg-2 col-md-6">
                <h4 class="footer-title">Navigation</h4>
                <ul class="footer-links">
                    <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                    <li><a href="@Url.Action("Services", "Home")">Services</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                    <li><a href="@Url.Action("Schedule", "Booking")">Book Now</a></li>
                </ul>
            </div>
            
            <!-- Services -->
            <div class="col-lg-3 col-md-6">
                <h4 class="footer-title">Services</h4>
                <ul class="footer-links">
                    <li><a href="#">Home Cleaning</a></li>
                    <li><a href="#">Office Cleaning</a></li>
                    <li><a href="#">Deep Cleaning</a></li>
                    <li><a href="#">Post-Construction</a></li>
                    <li><a href="#">Move In/Out</a></li>
                </ul>
            </div>
            
            <!-- Contact -->
            <div class="col-lg-3 col-md-6">
                <h4 class="footer-title">Contact</h4>
                <div class="footer-contact-item">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>123 Main Street<br>Miami, FL 33101</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-telephone-fill"></i>
                    <span>+1 (305) 555-0123</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-envelope-fill"></i>
                    <span>info@@ecomaid911.com</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-clock-fill"></i>
                    <span>Mon - Sat: 7:00 AM - 8:00 PM</span>
                </div>
            </div>
        </div>
        
        <!-- Newsletter -->
        <div class="row mt-5">
            <div class="col-lg-6 mx-auto">
                <div class="newsletter-box text-center p-4 rounded-4" style="background: rgba(255,255,255,0.05);">
                    <h5 class="mb-3">📧 Subscribe to our newsletter</h5>
                    <p class="text-muted mb-3">Receive exclusive offers and cleaning tips</p>
                    <form class="d-flex gap-2 justify-content-center flex-wrap">
                        <input type="email" class="form-control" placeholder="Your email address" 
                               style="max-width: 300px; border-radius: 50px; padding: 0.75rem 1.5rem;">
                        <button type="submit" class="btn-primary-gradient">
                            <i class="bi bi-send me-1"></i> Subscribe
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Bottom -->
        <div class="footer-bottom">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start text-center mb-3 mb-md-0">
                    &copy; @DateTime.Now.Year <strong>ecoMaid 911</strong>. All rights reserved.
                </div>
                <div class="col-md-6 text-md-end text-center">
                    <a href="#" class="text-muted text-decoration-none me-3">Privacy Policy</a>
                    <a href="#" class="text-muted text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </div>
</footer>
