@model IEnumerable<netcore.Models.Services.AdditionalServiceType>

@{
    ViewData["Title"] = "Servicios Adicionales";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewData["EntityIcon"] = "fa fa-plus-circle";
    ViewData["ListTitle"] = "Servicios Adicionales";
    ViewData["CreateLabel"] = "Nuevo Adicional";
    ViewData["IndexInfo"] = "Define servicios extras que los clientes pueden agregar a su reserva (lavado de ventanas, limpieza de alfombras, etc).";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h4><i class="icon fa fa-check"></i> ¡Éxito!</h4>
        @ViewBag.SuccessMessage
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h4><i class="icon fa fa-ban"></i> Error</h4>
        @ViewBag.ErrorMessage
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> Sin Servicios Adicionales</h4>
        <p>No hay servicios adicionales registrados.</p>
        <a asp-action="Create" class="btn btn-success"><i class="fa fa-plus"></i> Crear Primer Adicional</a>
    </div>
}
else
{
<table class="table table-hover table-striped" style="width:100%">
    <thead class="bg-primary">
        <tr>
            <th style="width: 140px;">Acciones</th>
            <th><i class="fa fa-tag"></i> Título</th>
            <th><i class="fa fa-money"></i> Costo</th>
            <th><i class="fa fa-dollar"></i> Precio</th>
            <th><i class="fa fa-check-circle"></i> Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="btn-group">
                        <a asp-action="Edit" asp-route-id="@item.AdditionalServiceTypeId" class="btn btn-warning btn-sm btn-action" title="Editar"><i class="fa fa-pencil"></i></a>
                        <a asp-action="Details" asp-route-id="@item.AdditionalServiceTypeId" class="btn btn-info btn-sm btn-action" title="Ver"><i class="fa fa-eye"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.AdditionalServiceTypeId" class="btn btn-danger btn-sm btn-action" title="Eliminar"><i class="fa fa-trash"></i></a>
                    </div>
                </td>
                <td><strong>@item.Title</strong></td>
                <td><span class="text-muted">$@item.Cost.ToString("N2")</span></td>
                <td><span class="label label-success">$@item.Price.ToString("N2")</span></td>
                <td>
                    @if (item.IsActive) {
                        <span class="label label-success"><i class="fa fa-check"></i> Activo</span>
                    } else {
                        <span class="label label-danger"><i class="fa fa-times"></i> Inactivo</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
}
