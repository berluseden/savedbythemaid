@model JempSoft.Core.Models.Services.AdditionalServiceType

@{
    ViewData["Title"] = "Eliminar Servicio Adicional";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewData["EntityIcon"] = "fa fa-plus-circle";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El servicio adicional no fue encontrado.</p>
    </div>
}
else
{
    <dl class="dl-horizontal">
        <dt><i class="fa fa-tag text-muted"></i> Título</dt>
        <dd><strong>@Model.Title</strong></dd>
        
        <dt><i class="fa fa-dollar text-muted"></i> Costo</dt>
        <dd>@Model.Cost.ToString("$#,##0.00")</dd>
        
        <dt><i class="fa fa-money text-muted"></i> Precio</dt>
        <dd><strong>@Model.Price.ToString("$#,##0.00")</strong></dd>
        
        <dt><i class="fa fa-check-circle text-muted"></i> Estado</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="label label-success">Activo</span>
            } else {
                <span class="label label-danger">Inactivo</span>
            }
        </dd>
    </dl>
    
    <input type="hidden" name="AdditionalServiceTypeId" value="@Model.AdditionalServiceTypeId" />
}
