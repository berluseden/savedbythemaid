@model netcore.Models.ApplicationUser

@{
    ViewData["Title"] = "Eliminar Usuario";
    Layout = "_AdminLTE4Delete";
    ViewBag.EntityName = "Usuario";
    ViewBag.EntityNamePlural = "Usuarios";
}

<div class="row g-4">
    <!-- Información del Usuario -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-person-fill me-2"></i>Datos del Usuario
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <img src="@Model.profilePictureUrl" class="rounded-circle me-3 shadow" 
                         style="width: 80px; height: 80px; object-fit: cover;"
                         onerror="this.src='https://ui-avatars.com/api/?name=@Model.UserName&background=random&size=80'" alt="Avatar">
                    <div>
                        <h4 class="mb-1">@Model.UserName</h4>
                        <p class="text-muted mb-0">@Model.Email</p>
                        @if (Model.isSuperAdmin)
                        {
                            <span class="badge bg-danger mt-1">
                                <i class="bi bi-shield-fill-check"></i> Super Admin
                            </span>
                        }
                    </div>
                </div>

                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <th class="text-muted" style="width: 40%;">
                                <i class="bi bi-telephone me-2"></i>Teléfono
                            </th>
                            <td>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "No registrado" : Model.PhoneNumber)</td>
                        </tr>
                        <tr>
                            <th class="text-muted">
                                <i class="bi bi-envelope-check me-2"></i>Email Confirmado
                            </th>
                            <td>
                                @if (Model.EmailConfirmed)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">No</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">
                                <i class="bi bi-shield-lock me-2"></i>2FA Activo
                            </th>
                            <td>
                                @if (Model.TwoFactorEnabled)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Roles del Usuario -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-key-fill me-2"></i>Roles Asignados
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @{ 
                        Type t = Model.GetType();
                        var roleIcons = new Dictionary<string, string> {
                            { "Home", "bi-house-door" },
                            { "ApplicationUser", "bi-people" },
                            { "Cleaning", "bi-house-check" },
                            { "Booking", "bi-calendar-check" },
                            { "InventoryCatalog", "bi-journal-text" },
                            { "InventoryTransaction", "bi-arrow-left-right" },
                            { "Reports", "bi-graph-up" }
                        };
                        
                        foreach (System.Reflection.PropertyInfo item in t.GetProperties())
                        {
                            if (item.Name.Contains("Role") && !item.Name.Contains("Line"))
                            {
                                bool vlue = (bool)item.GetValue(Model, null);
                                var displayName = item.Name.Replace("Role", "");
                                var iconClass = roleIcons.ContainsKey(displayName) ? roleIcons[displayName] : "bi-check-circle";
                                
                                if (vlue)
                                {
                                    <span class="badge bg-success py-2 px-3">
                                        <i class="bi @iconClass me-1"></i>@displayName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary py-2 px-3">
                                        <i class="bi @iconClass me-1"></i>@displayName
                                    </span>
                                }
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Formulario de Eliminación -->
<div class="row mt-4">
    <div class="col-12">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                </button>
            </div>
        </form>
    </div>
</div>


