@model netcore.Models.ApplicationUser

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "_AdminLTE4Edit";
    ViewBag.EntityName = "Usuario";
    ViewBag.EntityNamePlural = "Usuarios";
}

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserName" />
    <input type="hidden" asp-for="NormalizedUserName" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="NormalizedEmail" />
    <input type="hidden" asp-for="EmailConfirmed" />
    <input type="hidden" asp-for="PasswordHash" />
    <input type="hidden" asp-for="SecurityStamp" />
    <input type="hidden" asp-for="ConcurrencyStamp" />
    <input type="hidden" asp-for="PhoneNumber" />
    <input type="hidden" asp-for="PhoneNumberConfirmed" />
    <input type="hidden" asp-for="TwoFactorEnabled" />
    <input type="hidden" asp-for="LockoutEnd" />
    <input type="hidden" asp-for="LockoutEnabled" />
    <input type="hidden" asp-for="AccessFailedCount" />
    <input type="hidden" asp-for="profilePictureUrl" />
    
    <div class="row g-4">
        <!-- Información del Usuario -->
        <div class="col-lg-4">
            <div class="card card-info card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-person-circle me-2"></i>Información
                    </h3>
                </div>
                <div class="card-body text-center">
                    <img src="@Model.profilePictureUrl" class="rounded-circle mb-3 shadow" 
                         style="width: 120px; height: 120px; object-fit: cover;"
                         onerror="this.src='https://ui-avatars.com/api/?name=@Model.UserName&background=random&size=120'" alt="Avatar">
                    <h4 class="mb-1">@Model.UserName</h4>
                    <p class="text-muted mb-3">@Model.Email</p>
                    
                    @if (Model.isSuperAdmin)
                    {
                        <span class="badge bg-danger fs-6">
                            <i class="bi bi-shield-fill-check"></i> Super Administrador
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Permisos y Roles -->
        <div class="col-lg-8">
            <div class="card card-warning card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-key-fill me-2"></i>Permisos y Roles
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Super Admin -->
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="isSuperAdmin" role="switch">
                            <label class="form-check-label" asp-for="isSuperAdmin">
                                <i class="bi bi-shield-fill-exclamation me-1"></i>
                                <strong>Super Administrador</strong>
                                <small class="d-block text-muted">(Acceso total al sistema)</small>
                            </label>
                        </div>
                    </div>
                    
                    <hr />
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i>Selecciona los módulos a los que tendrá acceso:
                    </p>
                    
                    <div class="row g-3">
                        @{ 
                            Type t = Model.GetType();
                            var roleIcons = new Dictionary<string, string> {
                                { "Home", "bi-house-door text-info" },
                                { "ApplicationUser", "bi-people text-danger" },
                                { "Cleaning", "bi-house-check text-success" },
                                { "Booking", "bi-calendar-check text-primary" },
                                { "InventoryCatalog", "bi-journal-text text-warning" },
                                { "InventoryTransaction", "bi-arrow-left-right text-secondary" },
                                { "Reports", "bi-graph-up text-purple" }
                            };
                            
                            foreach (System.Reflection.PropertyInfo item in t.GetProperties())
                            {
                                if (item.Name.Contains("Role") && !item.Name.Contains("Line"))
                                {
                                    bool vlue = (bool)item.GetValue(Model, null);
                                    var displayName = item.Name.Replace("Role", "");
                                    var iconClass = roleIcons.ContainsKey(displayName) ? roleIcons[displayName] : "bi-check-circle";
                                    
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 @(vlue ? "border-success" : "")">
                                            <div class="card-body py-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" 
                                                           name="@item.Name" id="@item.Name" 
                                                           @(vlue ? "checked" : "")>
                                                    <label class="form-check-label" for="@item.Name">
                                                        <i class="bi @iconClass me-1 fs-5"></i>
                                                        <span class="fw-medium">@displayName</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Botones de Acción -->
    <div class="row mt-4">
        <div class="col-lg-4">
            <div class="alert alert-warning" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <h6 class="alert-heading mb-1">Importante</h6>
                        <p class="mb-0 small">Los cambios en los roles afectan inmediatamente los permisos del usuario.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function() {
            // Si marca SuperAdmin, marcar todos los roles
            $('#isSuperAdmin').change(function() {
                if ($(this).is(':checked')) {
                    $('input[type="checkbox"]').prop('checked', true);
                }
            });
            
            // Highlight de tarjetas seleccionadas
            $('input[type="checkbox"]').change(function() {
                var card = $(this).closest('.card');
                if ($(this).is(':checked')) {
                    card.addClass('border-success');
                } else {
                    card.removeClass('border-success');
                }
            });
        });
    </script>
}


