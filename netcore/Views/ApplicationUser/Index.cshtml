@model IEnumerable<netcore.Models.ApplicationUser>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "_AdminLTE4Index";
    ViewBag.EntityName = "Usuario";
    ViewBag.EntityNamePlural = "Usuarios";
}

<div class="table-responsive">
    <table class="table table-striped table-hover" id="usersTable">
        <thead class="table-dark">
            <tr>
                <th style="width: 100px;">Acciones</th>
                <th>Usuario</th>
                <th>Email</th>
                @{ 
                    Type t = typeof(ApplicationUser);
                    foreach (System.Reflection.PropertyInfo item in t.GetProperties())
                    {
                        if (item.Name.Contains("Role") && !item.Name.Contains("Line"))
                        {
                            var roleName = item.Name.Replace("Role", "");
                            <th class="text-center">@roleName</th>
                        }
                    }
                }
                <th class="text-center">SuperAdmin</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="@item.profilePictureUrl" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" alt="Avatar"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@item.UserName&background=random'">
                            <strong>@item.UserName</strong>
                        </div>
                    </td>
                    <td>@item.Email</td>
                    @{ 
                        Type ct = item.GetType();
                        foreach (System.Reflection.PropertyInfo ci in ct.GetProperties())
                        {
                            if (ci.Name.Contains("Role") && !ci.Name.Contains("Line"))
                            {
                                bool vlue = (bool)ci.GetValue(item, null);
                                <td class="text-center">
                                    @if (vlue) {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Sí
                                        </span>
                                    } else {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-x-circle"></i> No
                                        </span>
                                    }
                                </td>
                            }
                        }
                    }
                    <td class="text-center">
                        @if (item.isSuperAdmin) {
                            <span class="badge bg-danger">
                                <i class="bi bi-shield-fill-check"></i> SuperAdmin
                            </span>
                        } else {
                            <span class="badge bg-secondary">
                                <i class="bi bi-x-circle"></i> No
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="alert alert-info mt-3" role="alert">
    <div class="d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
        <div>
            <h6 class="alert-heading mb-1">Información</h6>
            <p class="mb-0">Haz clic en <i class="bi bi-pencil"></i> para editar los permisos de cada usuario. Los SuperAdmin tienen acceso a todas las funciones.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#usersTable').DataTable({
                responsive: true,
                pageLength: 25,
                language: {
                    search: "Buscar:",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ usuarios",
                    infoEmpty: "Sin usuarios",
                    infoFiltered: "(filtrado de _MAX_ usuarios)",
                    lengthMenu: "Mostrar _MENU_ registros",
                    paginate: { 
                        first: "Primero", 
                        last: "Último", 
                        next: "<i class='bi bi-chevron-right'></i>", 
                        previous: "<i class='bi bi-chevron-left'></i>" 
                    },
                    zeroRecords: "No se encontraron usuarios"
                },
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip'
            });
        });
    </script>
}





