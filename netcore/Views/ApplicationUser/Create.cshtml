@model netcore.VMs.ApplicationUserCreateVM

@{
    ViewData["Title"] = "Crear Usuario";
    Layout = "_AdminLTE4Create";
    ViewBag.EntityName = "Usuario";
    ViewBag.EntityNamePlural = "Usuarios";
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    
    <div class="row g-4">
        <!-- Información de Cuenta -->
        <div class="col-lg-6">
            <div class="card card-primary card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-person-fill me-2"></i>Información de Cuenta
                    </h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="usuario@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="UserName" class="form-control" placeholder="nombre.usuario" />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('Password')">
                                <i class="bi bi-eye" id="Password-icon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repetir contraseña" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('ConfirmPassword')">
                                <i class="bi bi-eye" id="ConfirmPassword-icon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+52 555 123 4567" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Permisos y Roles -->
        <div class="col-lg-6">
            <div class="card card-warning card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-key-fill me-2"></i>Permisos y Roles
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Super Admin -->
                    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsSuperAdmin" role="switch">
                            <label class="form-check-label" asp-for="IsSuperAdmin">
                                <i class="bi bi-shield-fill-exclamation me-1"></i>
                                <strong>@Html.DisplayNameFor(model => model.IsSuperAdmin)</strong>
                                <small class="d-block text-muted">(Acceso total al sistema)</small>
                            </label>
                        </div>
                    </div>
                    
                    <hr />
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i>Selecciona los módulos a los que tendrá acceso:
                    </p>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="HomeRole">
                                <label class="form-check-label" asp-for="HomeRole">
                                    <i class="bi bi-house-door text-info me-1"></i>
                                    @Html.DisplayNameFor(model => model.HomeRole)
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="ApplicationUserRole">
                                <label class="form-check-label" asp-for="ApplicationUserRole">
                                    <i class="bi bi-people text-danger me-1"></i>
                                    @Html.DisplayNameFor(model => model.ApplicationUserRole)
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="CleaningRole">
                                <label class="form-check-label" asp-for="CleaningRole">
                                    <i class="bi bi-house-check text-success me-1"></i>
                                    @Html.DisplayNameFor(model => model.CleaningRole)
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="BookingRole">
                                <label class="form-check-label" asp-for="BookingRole">
                                    <i class="bi bi-calendar-check text-primary me-1"></i>
                                    @Html.DisplayNameFor(model => model.BookingRole)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="InventoryCatalogRole">
                                <label class="form-check-label" asp-for="InventoryCatalogRole">
                                    <i class="bi bi-journal-text text-warning me-1"></i>
                                    @Html.DisplayNameFor(model => model.InventoryCatalogRole)
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="InventoryTransactionRole">
                                <label class="form-check-label" asp-for="InventoryTransactionRole">
                                    <i class="bi bi-arrow-left-right text-secondary me-1"></i>
                                    @Html.DisplayNameFor(model => model.InventoryTransactionRole)
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" asp-for="ReportsRole">
                                <label class="form-check-label" asp-for="ReportsRole">
                                    <i class="bi bi-graph-up text-purple me-1"></i>
                                    @Html.DisplayNameFor(model => model.ReportsRole)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Botones de Acción -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Crear Usuario
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePassword(fieldId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(fieldId + '-icon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
        
        $(function() {
            // Si marca SuperAdmin, marcar todos los roles
            $('#IsSuperAdmin').change(function() {
                if ($(this).is(':checked')) {
                    $('input[type="checkbox"]').prop('checked', true);
                }
            });
        });
    </script>
}

