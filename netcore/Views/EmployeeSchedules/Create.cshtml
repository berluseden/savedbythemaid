@model netcore.VMs.EmployeeScheduleVM

@{
    ViewData["Title"] = "Agregar Horario de Trabajo";
    Layout = "~/Views/Shared/_AdminLTE4Create.cshtml";
    ViewData["EntityIcon"] = "bi bi-calendar-plus";
    ViewData["CreateTitle"] = "Nuevo Horario de Trabajo";
    ViewData["CreateInfo"] = "Agregue los días disponibles para que este empleado pueda recibir asignaciones de trabajo.";
}

@if (Model?.Employee == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading mb-1">No hay empleado seleccionado</h5>
            <p class="mb-0">Por favor selecciona un empleado primero desde la <a asp-controller="Employees" asp-action="Index" class="alert-link">lista de empleados</a>.</p>
        </div>
    </div>
}
else
{
    <!-- Información del Empleado -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-person-badge me-2"></i>Información del Empleado
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-person-fill text-primary fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Nombre Completo</small>
                            <strong>@Model.Employee.FullName</strong>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-envelope-fill text-info fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Correo Electrónico</small>
                            <strong>@Model.Employee.EmailAddress</strong>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-telephone-fill text-success fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Teléfono</small>
                            <strong>@(Model.Employee.ContactNumber ?? "No registrado")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario para Agregar Día -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-calendar-plus me-2"></i>Agregar Día Disponible
            </h5>
        </div>
        <div class="card-body">
            <form method="post" asp-controller="EmployeeSchedules" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <input type="hidden" asp-for="Schedule.EmployeeId" />
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Schedule.AvaliableDay" class="form-label fw-semibold">
                            <i class="bi bi-calendar-date text-primary me-1"></i>Fecha Disponible <span class="text-danger">*</span>
                        </label>
                        <input type="date" asp-for="Schedule.AvaliableDay" class="form-control form-control-lg" />
                        <span asp-validation-for="Schedule.AvaliableDay" class="text-danger small"></span>
                        <small class="text-muted">Selecciona el día en que el empleado estará disponible para trabajar.</small>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range text-success me-1"></i>Opciones Adicionales
                        </label>
                        <div class="card bg-light border-0">
                            <div class="card-body py-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" asp-for="EntireYear" class="form-check-input" id="entireYear" style="width: 3rem; height: 1.5rem;">
                                    <label class="form-check-label ms-2" for="entireYear">
                                        <strong>Agregar todo el año</strong>
                                        <small class="d-block text-muted">Marca esta opción para crear horarios para todos los días del año seleccionado</small>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <hr class="my-4" />
                
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Agregar Horario
                    </button>
                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i>Volver al Empleado
                    </a>
                    <a asp-action="Index" class="btn btn-outline-dark btn-lg">
                        <i class="bi bi-list me-2"></i>Ver Todos los Horarios
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Ayuda contextual -->
    <div class="alert alert-info mt-4 d-flex" role="alert">
        <i class="bi bi-lightbulb-fill me-3 fs-4"></i>
        <div>
            <h6 class="alert-heading">💡 Consejo</h6>
            <p class="mb-0">Si el empleado trabaja todos los días de la semana, puedes usar la opción "Agregar todo el año" para crear automáticamente horarios para cada día. Luego podrás eliminar los días que no apliquen.</p>
        </div>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}