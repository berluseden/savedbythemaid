@model netcore.VMs.EmployeeScheduleVM


@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_AdminLTE4Details.cshtml";
    ViewData["EntityIcon"] = "fa fa-building-o";
    
}

@if (Model?.Employee == null)
{
    <div class="alert alert-warning">
        <h4><i class="icon fa fa-warning"></i> No Employee Selected</h4>
        Please select an employee first from the <a asp-controller="Employees" asp-action="Index">Employees list</a>.
    </div>
}
else
{
<h4>Employee Information</h4>

<div class="row">
    <div class="col-md-9">
        <!-- Default box -->
        <div class="card card-primary">
            <div class="card-body">
                <div>
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.Employee.FullName)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Employee.FullName)
                        </dd>
                        <dd>
                            @Html.DisplayFor(model => model.Employee.EmailAddress)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.Employee.User)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Employee.User.UserName)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <!-- /.box -->
    </div>
    <div class="col-md-3">
    </div>
</div>

<h4>Add Avaliable Day</h4>

<div class="row">
    <div class="col-md-9">
        <!-- Default box -->
        <div class="card card-primary">
            <div class="card-body">
                <div>

                    <div class="row">
                        <div class="col-md-12">
                            <form method="post" asp-controller="EmployeeSchedules" asp-action="Create">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="form-group col-md-6">

                                    <input type="hidden" asp-for="Schedule.EmployeeId" />
                                    @Html.HiddenFor(model => model.Schedule.EmployeeId)

                                    <label asp-for="Schedule.AvaliableDay" class="control-label"></label>
                                    <input asp-for="Schedule.AvaliableDay" class="form-control" />
                                    <span asp-validation-for="Schedule.AvaliableDay" class="text-danger"></span>

                                </div>

                                <div class="form-group col-md-6">
                                    <div class="checkbox">
                                      
                                        <input type="checkbox" asp-for="EntireYear" value="true" class="form-control" id="entireYear" />Entire Year<br />

                                    </div>
                                </div>

                                    <div class="form-group">
                                        <input type="submit" value="Add" class="btn btn-default" />
                                    </div>

                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <!-- /.box -->
    </div>
    <div class="col-md-3">
    </div>
</div>

<hr />


<div>
    <a asp-action="Index">Back to List</a>
</div>
}

@section Styles{

    <!-- iCheck -->
    

}

@section Scripts {

    <!-- iCheck -->
    

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue',
                increaseArea: '20%' /* optional */
            });         
        });
    </script>
    
}