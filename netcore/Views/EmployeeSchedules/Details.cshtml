@model JempSoft.Core.Models.EmployeeSchedule

@{
    ViewData["Title"] = "Detalles del Horario";
    Layout = "~/Views/Shared/_AdminLTE4Details.cshtml";
    ViewData["EntityIcon"] = "fa fa-calendar";
    ViewData["DetailsTitle"] = "Horario de Trabajo";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El horario no fue encontrado. <a asp-action="Index">Volver a la lista</a></p>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-calendar text-muted"></i> Día Disponible</div>
                <div class="detail-value"><strong>@Model.AvaliableDay</strong></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-check-circle text-muted"></i> Estado</div>
                <div class="detail-value">
                    @if (Model.IsActive) {
                        <span class="label label-success"><i class="fa fa-check"></i> Activo</span>
                    } else {
                        <span class="label label-danger"><i class="fa fa-times"></i> Inactivo</span>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="row" style="margin-top: 15px;">
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-user text-muted"></i> Empleado</div>
                <div class="detail-value">@(Model.Employee?.FullName ?? "N/A")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-phone text-muted"></i> Contacto</div>
                <div class="detail-value">@(Model.Employee?.ContactNumber ?? "N/A")</div>
            </div>
        </div>
    </div>
    
    <div class="row" style="margin-top: 15px;">
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-envelope text-muted"></i> Email</div>
                <div class="detail-value">@(Model.Employee?.EmailAddress ?? "N/A")</div>
            </div>
        </div>
    </div>
}
