@model JempSoft.Core.Models.EmployeeSchedule


@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_AdminlteNetcoreDetails.cshtml";
    ViewData["EntityIcon"] = "fa fa-building-o";

    var id = Model.Employee.EmployeeId;
}

<h2>Details</h2>

<div class="row">
    <div class="col-md-9">
        <!-- Default box -->
        <div class="box box-primary">
            <div class="box-body">
                <div>
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.Employee.FullName)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Employee.FullName)
                        </dd>                    
                        <dt>
                            @Html.DisplayNameFor(model => model.Employee.ContactNumber)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Employee.ContactNumber)
                        </dd>
                        <dt>
                            @Html.DisplayNameFor(model => model.Employee.EmailAddress)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Employee.EmailAddress)
                        </dd>                       
                    </dl>
                </div>
            </div>
            <!-- /.box-body -->
            <div class="box-footer">
                <div class="form-group">
                    <a asp-action="Edit" asp-route-id="@id" class="btn btn-primary">Edit</a>
                    <a asp-action="Index" class="btn btn-default">Back to List</a>
                </div>
            </div>
            <!-- /.box-footer-->
        </div>
        <!-- /.box -->
    </div>
    <div class="col-md-3">
    </div>
</div>

<h4>Employee Schedule</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-controller="EmployeeSchedules" asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @*<div class="form-group">
                <label asp-for="Schedule.AvaliableDay" class="control-label"></label>
                <input asp-for="Schedule.AvaliableDay" class="form-control" />
                <span asp-validation-for="Schedule.AvaliableDay" class="text-danger"></span>
            </div>*@

            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-default" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
