@model JempSoft.Core.Models.EmployeeSchedule

@{
    ViewData["Title"] = "Detalles del Horario";
    Layout = "~/Views/Shared/_AdminLTE4Details.cshtml";
    ViewData["EntityIcon"] = "bi bi-calendar-check";
    ViewData["DetailsTitle"] = "Horario de Trabajo";
}

@if (Model == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading mb-1">Horario no encontrado</h5>
            <p class="mb-0">El horario solicitado no existe. <a asp-action="Index" class="alert-link">Volver a la lista</a></p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Card de Fecha -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0"><i class="bi bi-calendar-date me-2"></i>Fecha Programada</h5>
                </div>
                <div class="card-body text-center py-4">
                    <div class="display-1 fw-bold text-primary">@Model.AvaliableDay.Day</div>
                    <div class="fs-4 text-muted">@Model.AvaliableDay.ToString("MMMM yyyy")</div>
                    <div class="mt-3">
                        <span class="badge bg-secondary fs-6">@Model.AvaliableDay.ToString("dddd")</span>
                    </div>
                </div>
                <div class="card-footer bg-light text-center">
                    @if (Model.IsActive) {
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                    } else {
                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                    }
                </div>
            </div>
        </div>

        <!-- Card de Empleado -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0"><i class="bi bi-person-badge me-2"></i>Empleado Asignado</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                            @(Model.Employee?.FirstName?.Substring(0, 1) ?? "?")@(Model.Employee?.LastName?.Substring(0, 1) ?? "")
                        </div>
                        <div>
                            <h5 class="mb-0">@(Model.Employee?.FullName ?? "No asignado")</h5>
                            <small class="text-muted">Empleado</small>
                        </div>
                    </div>
                    
                    <hr />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-telephone text-success me-2"></i>
                                <div>
                                    <small class="text-muted d-block">Teléfono</small>
                                    <strong>@(Model.Employee?.ContactNumber ?? "No registrado")</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-envelope text-info me-2"></i>
                                <div>
                                    <small class="text-muted d-block">Correo Electrónico</small>
                                    <strong>@(Model.Employee?.EmailAddress ?? "No registrado")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Botones de acción -->
    <div class="d-flex gap-2 mt-4">
        <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-primary">
            <i class="bi bi-person me-2"></i>Ver Empleado
        </a>
        <a asp-action="Delete" asp-route-id="@Model.EmployeeScheduleId" class="btn btn-danger">
            <i class="bi bi-trash me-2"></i>Eliminar Horario
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver a la Lista
        </a>
    </div>
}
