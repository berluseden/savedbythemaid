@model netcore.Models.EmployeeSchedule

@{
    ViewData["Title"] = "Eliminar Horario";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewData["EntityIcon"] = "fa fa-calendar-times-o";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El horario no fue encontrado. <a asp-action="Index">Volver a la lista</a></p>
    </div>
}
else
{
    <dl class="dl-horizontal">
        <dt><i class="fa fa-calendar text-muted"></i> Día Disponible</dt>
        <dd><strong>@Model.AvaliableDay</strong></dd>
        
        <dt><i class="fa fa-user text-muted"></i> Empleado</dt>
        <dd>@(Model.Employee?.FullName ?? "N/A")</dd>
        
        <dt><i class="fa fa-check-circle text-muted"></i> Estado</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="label label-success">Activo</span>
            } else {
                <span class="label label-danger">Inactivo</span>
            }
        </dd>
    </dl>
    
    <input type="hidden" name="EmployeeScheduleId" value="@Model.EmployeeScheduleId" />
}
