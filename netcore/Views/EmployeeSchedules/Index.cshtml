@model IEnumerable<JempSoft.Core.Models.EmployeeSchedule>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminlteNetcoreCreate.cshtml";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
                <th>
                    @Html.DisplayNameFor(model => model.AvaliableDay)
                </th>
            <th>
                FullName
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AvaliableDay)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Employee.FullName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EmployeeScheduleId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EmployeeScheduleId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EmployeeScheduleId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
