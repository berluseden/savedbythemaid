@model IEnumerable<JempSoft.Core.Models.EmployeeSchedule>

@{
    ViewData["Title"] = "Horarios";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewData["EntityIcon"] = "bi bi-calendar3";
    ViewData["ListTitle"] = "Horarios de Empleadas";
    ViewData["CreateLabel"] = "Nuevo Horario";
    ViewData["IndexInfo"] = "Gestiona los días y horas de disponibilidad de cada empleada.";
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading mb-1">Sin Horarios Registrados</h5>
            <p class="mb-2">No hay horarios de empleadas registrados.</p>
            <a asp-controller="Employees" asp-action="Index" class="btn btn-info btn-sm"><i class="bi bi-people me-1"></i> Ver Empleadas</a>
        </div>
    </div>
}
else
{
    <table class="table table-hover table-striped" style="width:100%">
        <thead class="table-light">
            <tr>
                <th style="width: 140px;">Acciones</th>
                <th><i class="bi bi-calendar-date me-1"></i> Día Disponible</th>
                <th><i class="bi bi-person me-1"></i> Empleada</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.EmployeeScheduleId" class="btn btn-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.EmployeeScheduleId" class="btn btn-info" title="Ver"><i class="bi bi-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.EmployeeScheduleId" class="btn btn-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-primary">@item.AvaliableDay.ToString("dd/MM/yyyy")</span>
                        <small class="text-muted ms-2">@item.AvaliableDay.ToString("dddd")</small>
                    </td>
                    <td><strong>@(item.Employee?.FullName ?? "N/A")</strong></td>
                </tr>
            }
        </tbody>
    </table>
}
