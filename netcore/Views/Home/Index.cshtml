@using JempSoft.Core.Models
@inject netcore.Data.ApplicationDbContext Context
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLTE4";

    // Métricas del negocio de limpieza
    var today = DateTime.Today;

    // Empleados
    int totalEmployees = Context.Employees.Count();
    
    // Reservas - usando ServiceOrders
    int todayBookings = Context.ServiceOrders.Count(s => s.Day == today.Day && s.Month == today.Month && s.Year == today.Year && s.IsActive);
    int monthBookings = Context.ServiceOrders.Count(s => s.Month == today.Month && s.Year == today.Year && s.IsActive);
    decimal monthRevenue = Context.ServiceOrders.Where(s => s.Month == today.Month && s.Year == today.Year && s.IsPayed).Sum(s => (decimal?)s.TotalAmount) ?? 0;
    int pendingPayments = Context.ServiceOrders.Count(s => !s.IsPayed && s.IsActive);
    int weekBookings = monthBookings;
    int monthClients = Context.ServiceOrders.Where(s => s.Month == today.Month && s.Year == today.Year).Select(s => s.ServiceContactInfoId).Distinct().Count();
    
    // Tipos de inmueble y servicios
    int cleaningPlaces = Context.CleaningPlaces.Count(c => c.IsActive);
    int serviceTypes = Context.ServiceTypes.Count(s => s.IsActive);
    
    // Horarios de empleados
    int employeeSchedules = Context.EmployeeSchedules.Count();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><i class="bi bi-house-door"></i> Inicio</li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </nav>
                <h2 class="mb-0">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>
                    Dashboard
                    <small class="text-muted fs-6">Panel de control - SavedByTheMaid</small>
                </h2>
            </div>
        </div>
    </div>

    <!-- Alerta de bienvenida -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-info alert-dismissible fade show d-flex align-items-center" role="alert" id="welcomeAlert">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1">¡Bienvenido al Panel de Administración!</h5>
                    <p class="mb-0">Gestiona reservas, empleados, servicios y más. Usa el menú lateral para navegar.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Tarjetas de estadísticas principales -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 overflow-hidden">
                <div class="card-body position-relative" style="background: linear-gradient(135deg, #06B6D4 0%, #0891B2 100%);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="text-white">
                            <h2 class="mb-1 fw-bold">@todayBookings</h2>
                            <p class="mb-0 opacity-75">Reservas Hoy</p>
                        </div>
                        <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
                            <i class="bi bi-calendar-check fs-4 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 4px; background: rgba(255,255,255,0.3);">
                            <div class="progress-bar bg-white" style="width: @(todayBookings > 0 ? Math.Min(todayBookings * 10, 100) : 0)%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 py-2">
                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@today.ToString("dd MMM yyyy")</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 overflow-hidden">
                <div class="card-body position-relative" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="text-white">
                            <h2 class="mb-1 fw-bold">$@monthRevenue.ToString("N0")</h2>
                            <p class="mb-0 opacity-75">Ingresos del Mes</p>
                        </div>
                        <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
                            <i class="bi bi-currency-dollar fs-4 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 4px; background: rgba(255,255,255,0.3);">
                            <div class="progress-bar bg-white" style="width: 70%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 py-2">
                    <small class="text-muted"><i class="bi bi-graph-up-arrow me-1"></i>@monthBookings reservas</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 overflow-hidden">
                <div class="card-body position-relative" style="background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="text-white">
                            <h2 class="mb-1 fw-bold">@totalEmployees</h2>
                            <p class="mb-0 opacity-75">Empleadas Activas</p>
                        </div>
                        <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
                            <i class="bi bi-people-fill fs-4 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 4px; background: rgba(255,255,255,0.3);">
                            <div class="progress-bar bg-white" style="width: @(totalEmployees > 0 ? 100 : 0)%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 py-2">
                    <small class="text-muted"><i class="bi bi-person-plus me-1"></i>Personal disponible</small>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 overflow-hidden">
                <div class="card-body position-relative" style="background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="text-white">
                            <h2 class="mb-1 fw-bold">@pendingPayments</h2>
                            <p class="mb-0 opacity-75">Pagos Pendientes</p>
                        </div>
                        <div class="rounded-circle p-2" style="background: rgba(255,255,255,0.2);">
                            <i class="bi bi-clock-history fs-4 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 4px; background: rgba(255,255,255,0.3);">
                            <div class="progress-bar bg-white" style="width: @(pendingPayments > 0 ? Math.Min(pendingPayments * 5, 100) : 0)%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 py-2">
                    <small class="text-muted"><i class="bi bi-exclamation-triangle me-1"></i>Requieren atención</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Segunda fila - Small boxes -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #4F46E5 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h3 class="mb-1 fw-bold text-primary">@weekBookings</h3>
                        <p class="text-muted mb-0 small">Reservas Esta Semana</p>
                    </div>
                    <div class="rounded-3 p-3" style="background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);">
                        <i class="bi bi-calendar-week fs-4 text-primary"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="@Url.Action("Index", "ServiceMeet")" class="text-decoration-none small">
                        Ver todas <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #DC2626 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h3 class="mb-1 fw-bold text-danger">@monthClients</h3>
                        <p class="text-muted mb-0 small">Clientes del Mes</p>
                    </div>
                    <div class="rounded-3 p-3" style="background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);">
                        <i class="bi bi-people-fill fs-4 text-danger"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="@Url.Action("Index", "Customer")" class="text-decoration-none small">
                        Ver detalles <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #6B7280 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h3 class="mb-1 fw-bold text-secondary">@cleaningPlaces</h3>
                        <p class="text-muted mb-0 small">Tipos de Inmueble</p>
                    </div>
                    <div class="rounded-3 p-3" style="background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);">
                        <i class="bi bi-house-door fs-4 text-secondary"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="@Url.Action("Index", "CleaningPlaces")" class="text-decoration-none small">
                        Gestionar <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #10B981 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h3 class="mb-1 fw-bold text-success">@serviceTypes</h3>
                        <p class="text-muted mb-0 small">Tipos de Servicio</p>
                    </div>
                    <div class="rounded-3 p-3" style="background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);">
                        <i class="bi bi-tags fs-4 text-success"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="@Url.Action("Index", "ServiceTypes")" class="text-decoration-none small">
                        Gestionar <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos y acciones rápidas -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card card-primary card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-bar-chart-line me-2"></i>Actividad del Negocio
                    </h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="activityChart" style="height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card card-warning card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-lightning-fill me-2"></i>Acciones Rápidas
                    </h3>
                </div>
                <div class="card-body p-2">
                    <div class="row g-2">
                        <div class="col-6">
                            <a href="@Url.Action("Create", "Employees")" class="btn btn-outline-primary w-100 py-2 d-flex flex-column align-items-center">
                                <i class="bi bi-person-plus fs-5 mb-1"></i>
                                <span style="font-size: 0.75rem;">Nueva Empleada</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Create", "CleaningPlaces")" class="btn btn-outline-success w-100 py-2 d-flex flex-column align-items-center">
                                <i class="bi bi-house-add fs-5 mb-1"></i>
                                <span style="font-size: 0.75rem;">Nuevo Inmueble</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Create", "ServiceTypes")" class="btn btn-outline-warning w-100 py-2 d-flex flex-column align-items-center">
                                <i class="bi bi-tag fs-5 mb-1"></i>
                                <span style="font-size: 0.75rem;">Nuevo Servicio</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Index", "Employees")" class="btn btn-outline-info w-100 py-2 d-flex flex-column align-items-center position-relative">
                                <span class="badge bg-warning position-absolute top-0 end-0" style="font-size: 0.6rem;">@totalEmployees</span>
                                <i class="bi bi-people fs-5 mb-1"></i>
                                <span style="font-size: 0.75rem;">Empleadas</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Create", "EmployeeSchedules")" class="btn btn-outline-secondary w-100 py-2 d-flex flex-column align-items-center">
                                <i class="bi bi-calendar-plus fs-5 mb-1"></i>
                                <span style="font-size: 0.75rem;">Nuevo Horario</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Index", "EmployeeSchedules")" class="btn btn-outline-dark w-100 py-2 d-flex flex-column align-items-center position-relative">
                                <span class="badge bg-info position-absolute top-0 end-0" style="font-size: 0.6rem;">@employeeSchedules</span>
                                <i class="bi bi-calendar3 fs-5 mb-1"></i>
                                <span style="font-size: 0.75rem;">Horarios</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Estado del sistema y servicios -->
    <div class="row g-4">
        <div class="col-lg-4 col-md-6">
            <div class="card card-success card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-pie-chart me-2"></i>Distribución de Servicios
                    </h3>
                </div>
                <div class="card-body">
                    <canvas id="servicesChart" style="height: 200px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card card-info card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-list-check me-2"></i>Estado del Sistema
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-people-fill text-warning me-2"></i>Empleadas</span>
                            <span class="badge @(totalEmployees > 0 ? "bg-success" : "bg-danger") rounded-pill">
                                @(totalEmployees > 0 ? totalEmployees + " activas" : "Sin registrar")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-house-door text-purple me-2"></i>Inmuebles</span>
                            <span class="badge @(cleaningPlaces > 0 ? "bg-success" : "bg-warning") rounded-pill">
                                @cleaningPlaces tipos
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-tags text-danger me-2"></i>Servicios</span>
                            <span class="badge @(serviceTypes > 0 ? "bg-success" : "bg-warning") rounded-pill">
                                @serviceTypes activos
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="card card-danger card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-lightbulb me-2"></i>Guía Rápida
                    </h3>
                </div>
                <div class="card-body">
                    @if(totalEmployees == 0)
                    {
                        <div class="alert alert-warning" role="alert">
                            <h6 class="alert-heading">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Configuración Pendiente
                            </h6>
                            <ol class="small mb-0 ps-3">
                                <li><a href="@Url.Action("Create", "Employees")" class="alert-link">Registrar empleadas</a></li>
                                <li><a href="@Url.Action("Create", "EmployeeSchedules")" class="alert-link">Crear horarios</a></li>
                                <li>Verificar tipos de servicio</li>
                            </ol>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success" role="alert">
                            <h6 class="alert-heading">
                                <i class="bi bi-check-circle-fill me-2"></i>Sistema Configurado
                            </h6>
                            <p class="small mb-0">El sistema está listo para recibir reservas.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function() {
            // Ocultar alerta después de 8 segundos
            setTimeout(function() { 
                const alert = bootstrap.Alert.getOrCreateInstance('#welcomeAlert');
                if (alert) alert.close();
            }, 8000);

            // Gráfico de actividad
            var ctx = document.getElementById('activityChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Reservas',
                        data: [12, 19, 15, 25, 22, @monthBookings],
                        borderColor: 'rgba(60, 141, 188, 1)',
                        backgroundColor: 'rgba(60, 141, 188, 0.2)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Gráfico de servicios
            var ctx2 = document.getElementById('servicesChart').getContext('2d');
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Casa', 'Apartamento', 'Oficina', 'Otro'],
                    datasets: [{
                        data: [45, 30, 15, 10],
                        backgroundColor: [
                            'rgba(60, 141, 188, 0.8)', 
                            'rgba(0, 166, 90, 0.8)', 
                            'rgba(243, 156, 18, 0.8)', 
                            'rgba(221, 75, 57, 0.8)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // Toastr notification
            @if(totalEmployees == 0) {
                <text>toastr.warning('Configura el sistema para comenzar a recibir reservas.', '¡Atención!');</text>
            } else {
                <text>toastr.success('Dashboard cargado correctamente', 'SavedByTheMaid');</text>
            }
        });
    </script>
}