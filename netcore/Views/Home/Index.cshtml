@using JempSoft.Core.Models
@inject netcore.Data.ApplicationDbContext Context
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLTE4";

    // Métricas del negocio de limpieza
    var today = DateTime.Today;

    // Empleados
    int totalEmployees = Context.Employees.Count();
    
    // Reservas - usando ServiceOrders
    int todayBookings = Context.ServiceOrders.Count(s => s.Day == today.Day && s.Month == today.Month && s.Year == today.Year && s.IsActive);
    int monthBookings = Context.ServiceOrders.Count(s => s.Month == today.Month && s.Year == today.Year && s.IsActive);
    decimal monthRevenue = Context.ServiceOrders.Where(s => s.Month == today.Month && s.Year == today.Year && s.IsPayed).Sum(s => (decimal?)s.TotalAmount) ?? 0;
    int pendingPayments = Context.ServiceOrders.Count(s => !s.IsPayed && s.IsActive);
    int weekBookings = monthBookings;
    int monthClients = Context.ServiceOrders.Where(s => s.Month == today.Month && s.Year == today.Year).Select(s => s.ServiceContactInfoId).Distinct().Count();
    
    // Tipos de inmueble y servicios
    int cleaningPlaces = Context.CleaningPlaces.Count(c => c.IsActive);
    int serviceTypes = Context.ServiceTypes.Count(s => s.IsActive);
    
    // Horarios de empleados
    int employeeSchedules = Context.EmployeeSchedules.Count();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><i class="bi bi-house-door"></i> Inicio</li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </nav>
                <h2 class="mb-0">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>
                    Dashboard
                    <small class="text-muted fs-6">Panel de control - SavedByTheMaid</small>
                </h2>
            </div>
        </div>
    </div>

    <!-- Alerta de bienvenida -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-info alert-dismissible fade show d-flex align-items-center" role="alert" id="welcomeAlert">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1">¡Bienvenido al Panel de Administración!</h5>
                    <p class="mb-0">Gestiona reservas, empleados, servicios y más. Usa el menú lateral para navegar.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Tarjetas de estadísticas principales -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="small-box text-bg-info">
                <div class="inner">
                    <h3>@todayBookings</h3>
                    <p>Reservas Hoy</p>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-light" style="width: @(todayBookings > 0 ? Math.Min(todayBookings * 10, 100) : 0)%"></div>
                </div>
                <span class="small-card-footer">
                    <i class="bi bi-calendar3"></i> @today.ToString("dd MMM yyyy")
                </span>
                <div class="small-box-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box text-bg-success">
                <div class="inner">
                    <h3>$@monthRevenue.ToString("N0")</h3>
                    <p>Ingresos del Mes</p>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-light" style="width: 70%"></div>
                </div>
                <span class="small-card-footer">
                    <i class="bi bi-graph-up-arrow"></i> @monthBookings reservas
                </span>
                <div class="small-box-icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box text-bg-warning">
                <div class="inner">
                    <h3>@totalEmployees</h3>
                    <p>Empleadas Activas</p>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-light" style="width: @(totalEmployees > 0 ? 100 : 0)%"></div>
                </div>
                <span class="small-card-footer">
                    <i class="bi bi-person-plus"></i> Personal disponible
                </span>
                <div class="small-box-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box text-bg-danger">
                <div class="inner">
                    <h3>@pendingPayments</h3>
                    <p>Pagos Pendientes</p>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-light" style="width: @(pendingPayments > 0 ? Math.Min(pendingPayments * 5, 100) : 0)%"></div>
                </div>
                <span class="small-card-footer">
                    <i class="bi bi-exclamation-triangle"></i> Requieren atención
                </span>
                <div class="small-box-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Segunda fila - Small boxes -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="small-box text-bg-primary">
                <div class="inner">
                    <h3>@weekBookings</h3>
                    <p>Reservas Esta Semana</p>
                </div>
                <a href="#" class="small-card-footer">
                    Ver todas <i class="bi bi-arrow-right-circle"></i>
                </a>
                <div class="small-box-icon">
                    <i class="bi bi-calendar-week"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box" style="background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%); color: white;">
                <div class="inner">
                    <h3>@monthClients</h3>
                    <p>Clientes del Mes</p>
                </div>
                <a href="#" class="small-card-footer text-white">
                    Ver detalles <i class="bi bi-arrow-right-circle"></i>
                </a>
                <div class="small-box-icon">
                    <i class="bi bi-person-heart"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box text-bg-secondary">
                <div class="inner">
                    <h3>@cleaningPlaces</h3>
                    <p>Tipos de Inmueble</p>
                </div>
                <a href="@Url.Action("Index", "CleaningPlaces")" class="small-card-footer">
                    Gestionar <i class="bi bi-arrow-right-circle"></i>
                </a>
                <div class="small-box-icon">
                    <i class="bi bi-house-door"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="small-box" style="background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%); color: white;">
                <div class="inner">
                    <h3>@serviceTypes</h3>
                    <p>Tipos de Servicio</p>
                </div>
                <a href="@Url.Action("Index", "ServiceTypes")" class="small-card-footer text-white">
                    Gestionar <i class="bi bi-arrow-right-circle"></i>
                </a>
                <div class="small-box-icon">
                    <i class="bi bi-tags"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos y acciones rápidas -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card card-primary card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-bar-chart-line me-2"></i>Actividad del Negocio
                    </h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="activityChart" style="height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card card-warning card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-lightning-fill me-2"></i>Acciones Rápidas
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <a href="@Url.Action("Create", "Employees")" class="btn btn-outline-primary w-100 py-3">
                                <i class="bi bi-person-plus d-block fs-4 mb-1"></i>
                                <small>Nueva Empleada</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Create", "CleaningPlaces")" class="btn btn-outline-success w-100 py-3">
                                <i class="bi bi-house-add d-block fs-4 mb-1"></i>
                                <small>Nuevo Inmueble</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Create", "ServiceTypes")" class="btn btn-outline-warning w-100 py-3">
                                <i class="bi bi-tag d-block fs-4 mb-1"></i>
                                <small>Nuevo Servicio</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Index", "Employees")" class="btn btn-outline-info w-100 py-3 position-relative">
                                <span class="badge bg-warning position-absolute top-0 end-0 translate-middle">@totalEmployees</span>
                                <i class="bi bi-people d-block fs-4 mb-1"></i>
                                <small>Empleadas</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Create", "EmployeeSchedules")" class="btn btn-outline-secondary w-100 py-3">
                                <i class="bi bi-calendar-plus d-block fs-4 mb-1"></i>
                                <small>Nuevo Horario</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="@Url.Action("Index", "EmployeeSchedules")" class="btn btn-outline-dark w-100 py-3 position-relative">
                                <span class="badge bg-info position-absolute top-0 end-0 translate-middle">@employeeSchedules</span>
                                <i class="bi bi-calendar3 d-block fs-4 mb-1"></i>
                                <small>Horarios</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Estado del sistema y servicios -->
    <div class="row g-4">
        <div class="col-lg-4 col-md-6">
            <div class="card card-success card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-pie-chart me-2"></i>Distribución de Servicios
                    </h3>
                </div>
                <div class="card-body">
                    <canvas id="servicesChart" style="height: 200px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card card-info card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-list-check me-2"></i>Estado del Sistema
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-people-fill text-warning me-2"></i>Empleadas</span>
                            <span class="badge @(totalEmployees > 0 ? "bg-success" : "bg-danger") rounded-pill">
                                @(totalEmployees > 0 ? totalEmployees + " activas" : "Sin registrar")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-house-door text-purple me-2"></i>Inmuebles</span>
                            <span class="badge @(cleaningPlaces > 0 ? "bg-success" : "bg-warning") rounded-pill">
                                @cleaningPlaces tipos
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-tags text-danger me-2"></i>Servicios</span>
                            <span class="badge @(serviceTypes > 0 ? "bg-success" : "bg-warning") rounded-pill">
                                @serviceTypes activos
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="card card-danger card-outline h-100">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-lightbulb me-2"></i>Guía Rápida
                    </h3>
                </div>
                <div class="card-body">
                    @if(totalEmployees == 0)
                    {
                        <div class="alert alert-warning" role="alert">
                            <h6 class="alert-heading">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Configuración Pendiente
                            </h6>
                            <ol class="small mb-0 ps-3">
                                <li><a href="@Url.Action("Create", "Employees")" class="alert-link">Registrar empleadas</a></li>
                                <li><a href="@Url.Action("Create", "EmployeeSchedules")" class="alert-link">Crear horarios</a></li>
                                <li>Verificar tipos de servicio</li>
                            </ol>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success" role="alert">
                            <h6 class="alert-heading">
                                <i class="bi bi-check-circle-fill me-2"></i>Sistema Configurado
                            </h6>
                            <p class="small mb-0">El sistema está listo para recibir reservas.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function() {
            // Ocultar alerta después de 8 segundos
            setTimeout(function() { 
                const alert = bootstrap.Alert.getOrCreateInstance('#welcomeAlert');
                if (alert) alert.close();
            }, 8000);

            // Gráfico de actividad
            var ctx = document.getElementById('activityChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Reservas',
                        data: [12, 19, 15, 25, 22, @monthBookings],
                        borderColor: 'rgba(60, 141, 188, 1)',
                        backgroundColor: 'rgba(60, 141, 188, 0.2)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Gráfico de servicios
            var ctx2 = document.getElementById('servicesChart').getContext('2d');
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Casa', 'Apartamento', 'Oficina', 'Otro'],
                    datasets: [{
                        data: [45, 30, 15, 10],
                        backgroundColor: [
                            'rgba(60, 141, 188, 0.8)', 
                            'rgba(0, 166, 90, 0.8)', 
                            'rgba(243, 156, 18, 0.8)', 
                            'rgba(221, 75, 57, 0.8)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // Toastr notification
            @if(totalEmployees == 0) {
                <text>toastr.warning('Configura el sistema para comenzar a recibir reservas.', '¡Atención!');</text>
            } else {
                <text>toastr.success('Dashboard cargado correctamente', 'SavedByTheMaid');</text>
            }
        });
    </script>
}