@model IEnumerable<JempSoft.Applications.Invent.Dto.CustomerOutputDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewData["EntityIcon"] = "bi bi-people";
    ViewData["ListTitle"] = "Customer List";
    ViewData["IndexInfo"] = "Customer is an organization that buy products from your company. You sell products to them.";
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle me-2"></i>No Customers Found</h4>
        There are no customers registered yet. <a asp-action="Create" class="alert-link">Create your first customer</a> to start managing your clients.
    </div>
}
else
{
<table class="table table-hover table-striped" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerName)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Size)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Street1)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Street2)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Province)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Country)
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-info" title="Details"><i class="bi bi-eye"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-danger" title="Delete"><i class="bi bi-trash"></i></a>
                </div>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CustomerName)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Size)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Street1)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Street2)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Province)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Country)
            </td>

        </tr>
        }
    </tbody>
</table>
}
