@model JempSoft.Core.Models.CleaningPlace

@{
    ViewData["Title"] = "Detalles del Tipo de Inmueble";
    Layout = "~/Views/Shared/_AdminLTE4Details.cshtml";
    ViewData["EntityIcon"] = "fa fa-home";
    ViewData["DetailsTitle"] = "Tipo de Inmueble";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El tipo de inmueble no fue encontrado.</p>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-home text-muted"></i> Título</div>
                <div class="detail-value"><strong>@Model.Title</strong></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-check-circle text-muted"></i> Estado</div>
                <div class="detail-value">
                    @if (Model.IsActive) {
                        <span class="label label-success"><i class="fa fa-check"></i> Activo</span>
                    } else {
                        <span class="label label-danger"><i class="fa fa-times"></i> Inactivo</span>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <div class="row" style="margin-top: 15px;">
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-calendar text-muted"></i> Creación</div>
                <div class="detail-value">@Model.CreationDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-refresh text-muted"></i> Actualización</div>
                <div class="detail-value">@(Model.UpdateDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
            </div>
        </div>
    </div>
}
