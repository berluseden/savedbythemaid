@model netcore.Models.CleaningPlace

@{
    ViewData["Title"] = "Detalles del Tipo de Inmueble";
    Layout = "~/Views/Shared/_AdminLTE4Details.cshtml";
    ViewBag.EntityName = "Tipo de Inmueble";
    ViewBag.EntityNamePlural = "Tipos de Inmueble";
    ViewBag.EntityId = Model?.CleaningPlaceId;
}

@if (Model == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>El tipo de inmueble no fue encontrado.</div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4"><i class="bi bi-house me-1"></i> Título</dt>
                <dd class="col-sm-8"><strong>@Model.Title</strong></dd>
            </dl>
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4"><i class="bi bi-toggle-on me-1"></i> Estado</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive) {
                        <span class="badge bg-success"><i class="bi bi-check me-1"></i> Activo</span>
                    } else {
                        <span class="badge bg-danger"><i class="bi bi-x me-1"></i> Inactivo</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
    
    <div class="row mt-3">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4"><i class="bi bi-calendar me-1"></i> Creación</dt>
                <dd class="col-sm-8">@Model.CreationDate.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4"><i class="bi bi-arrow-clockwise me-1"></i> Actualización</dt>
                <dd class="col-sm-8">@(Model.UpdateDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
            </dl>
        </div>
    </div>
}
