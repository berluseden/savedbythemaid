@model JempSoft.Core.Models.CleaningPlace

@{
    ViewData["Title"] = "Nuevo Tipo de Inmueble";
    Layout = "~/Views/Shared/_AdminLTE4Create.cshtml";
    ViewData["EntityIcon"] = "fa fa-home";
    ViewData["FormTitle"] = "Nuevo Tipo de Inmueble";
    ViewBag.CreateInfo = "Define un tipo de inmueble para los servicios de limpieza (Casa, Apartamento, Oficina, etc).";
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h4><i class="icon fa fa-ban"></i> Error</h4>
        @ViewBag.ErrorMessage
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="form-group">
            <label asp-for="Title" class="control-label"><i class="fa fa-home text-muted"></i> Nombre del Tipo <span class="text-danger">*</span></label>
            <input asp-for="Title" class="form-control" placeholder="Ej: Casa, Apartamento, Oficina, Local Comercial" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        
        <div class="form-group">
            <div class="checkbox">
                <label style="font-weight: 600;">
                    <input asp-for="IsActive" checked /> <i class="fa fa-check-circle text-success"></i> Activo
                </label>
                <small class="help-block">Si está desactivado, no aparecerá en las opciones de reserva</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
