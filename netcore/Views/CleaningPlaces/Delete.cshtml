@model JempSoft.Core.Models.CleaningPlace

@{
    ViewData["Title"] = "Eliminar Tipo de Inmueble";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewData["EntityIcon"] = "fa fa-home";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El tipo de inmueble no fue encontrado.</p>
    </div>
}
else
{
    <dl class="dl-horizontal">
        <dt><i class="fa fa-home text-muted"></i> Título</dt>
        <dd><strong>@Model.Title</strong></dd>
        
        <dt><i class="fa fa-check-circle text-muted"></i> Estado</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="label label-success">Activo</span>
            } else {
                <span class="label label-danger">Inactivo</span>
            }
        </dd>
        
        <dt><i class="fa fa-calendar text-muted"></i> Creación</dt>
        <dd>@Model.CreationDate.ToString("dd/MM/yyyy")</dd>
    </dl>
    
    <input type="hidden" name="CleaningPlaceId" value="@Model.CleaningPlaceId" />
}
