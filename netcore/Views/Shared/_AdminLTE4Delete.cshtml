@{
    Layout = "_AdminLTE4";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="page-header mb-4">
                <div class="row align-items-center">
                    <div class="col">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-2">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="bi bi-house"></i> Inicio</a></li>
                                @if (ViewBag.EntityNamePlural != null)
                                {
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">@ViewBag.EntityNamePlural</a></li>
                                }
                                <li class="breadcrumb-item active">Eliminar</li>
                            </ol>
                        </nav>
                        <h2 class="mb-0">
                            <i class="bi bi-trash text-danger me-2"></i>
                            Eliminar @(ViewBag.EntityName ?? "Registro")
                        </h2>
                    </div>
                    <div class="col-auto">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a la lista
                        </a>
                    </div>
                </div>
            </div>

            <!-- Content Card -->
            <div class="card card-danger card-outline">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Confirmar Eliminación
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            <strong>¡Atención!</strong> Esta acción no se puede deshacer. ¿Está seguro de que desea eliminar este registro?
                        </div>
                    </div>
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
