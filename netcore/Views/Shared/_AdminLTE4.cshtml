<!DOCTYPE html>
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject netcore.Data.ApplicationDbContext Context
@{
    ApplicationUser appUser = await UserManager.GetUserAsync(User);
    bool isSuperAdmin = appUser?.isSuperAdmin ?? false;
}
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - JempSoft</title>
    
    @await Html.PartialAsync("_AdminLTE4Styles")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        
        @await Html.PartialAsync("_AdminLTE4Header", appUser)
        
        @await Html.PartialAsync("_AdminLTE4Sidebar", appUser)
        
        <main class="app-main">
            @RenderBody()
            
            @await Html.PartialAsync("_AdminLTE4Footer")
        </main>
    </div>

    @await Html.PartialAsync("_AdminLTE4Scripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
