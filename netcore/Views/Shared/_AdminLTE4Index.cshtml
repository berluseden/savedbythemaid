@{
    Layout = "_AdminLTE4";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="page-header mb-4">
                <div class="row align-items-center">
                    <div class="col">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-2">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="bi bi-house"></i> Inicio</a></li>
                                <li class="breadcrumb-item active">@(ViewBag.EntityNamePlural ?? "Registros")</li>
                            </ol>
                        </nav>
                        <h2 class="mb-0">
                            <i class="bi bi-list-ul text-info me-2"></i>
                            @(ViewBag.EntityNamePlural ?? "Registros")
                        </h2>
                    </div>
                    <div class="col-auto">
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <i class="bi bi-plus-lg"></i> Crear Nuevo
                        </a>
                    </div>
                </div>
            </div>

            <!-- Content Card -->
            <div class="card card-info card-outline">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-table me-2"></i>
                        Lista de @(ViewBag.EntityNamePlural ?? "Registros")
                    </h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-maximize">
                            <i class="bi bi-fullscreen"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
