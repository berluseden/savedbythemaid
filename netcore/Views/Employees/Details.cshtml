@model netcore.VMs.EmployeeScheduleVM

@{
    ViewData["Title"] = "Detalles del Empleado";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewBag.EntityName = "Empleado";
    ViewBag.EntityNamePlural = "Empleados";
}

@if (Model?.Employee == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>El empleado no fue encontrado. <a asp-action="Index">Volver a la lista</a></div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h4 class="card-title"><i class="bi bi-person me-2"></i> Información del Empleado</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4"><i class="bi bi-person me-1"></i> Nombre Completo</dt>
                                <dd class="col-sm-8"><strong>@Model.Employee.FullName</strong></dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4"><i class="bi bi-card-text me-1"></i> Identificación</dt>
                                <dd class="col-sm-8">@Model.Employee.Identification</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4"><i class="bi bi-telephone me-1"></i> Teléfono</dt>
                                <dd class="col-sm-8">@Model.Employee.ContactNumber</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4"><i class="bi bi-envelope me-1"></i> Email</dt>
                                <dd class="col-sm-8">@Model.Employee.EmailAddress</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Create" asp-controller="EmployeeSchedules" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-success"><i class="bi bi-calendar-plus me-1"></i> Agregar Horario</a>
                    <a asp-action="Edit" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Editar</a>
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-info card-outline">
        <div class="card-header">
            <h4 class="card-title"><i class="bi bi-calendar3 me-2"></i> Horarios de Trabajo</h4>
        </div>
        <div class="card-body">
            @if (Model.EmployeeSchedule == null || !Model.EmployeeSchedule.Any())
            {
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <div>No se encontraron horarios para este empleado.
                    <a asp-action="Create" asp-controller="EmployeeSchedules" asp-route-id="@Model.Employee.EmployeeId" class="alert-link"><strong>Agregar el primer horario</strong></a>.</div>
                </div>
            }
            else
            {
                <table class="table table-hover table-striped" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Acciones</th>
                            <th>Día</th>
                            <th>Mes</th>
                            <th>Año</th>
                            <th>Fecha Completa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.EmployeeSchedule)
                        {
                            <tr>
                                <td>
                                    <div class="btn-group">
                                        <a asp-controller="EmployeeSchedules" asp-action="Details" asp-route-id="@item.EmployeeScheduleId" class="btn btn-primary btn-sm" title="Ver Detalles"><i class="bi bi-eye"></i></a>
                                        <a asp-controller="EmployeeSchedules" asp-action="Delete" asp-route-id="@item.EmployeeScheduleId" class="btn btn-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                                <td>@item.AvaliableDay.Day</td>
                                <td>@item.AvaliableDay.ToString("MMMM")</td>
                                <td>@item.AvaliableDay.Year</td>
                                <td><strong>@item.AvaliableDay.ToString("dd/MM/yyyy")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}