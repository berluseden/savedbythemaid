@model netcore.VMs.EmployeeScheduleVM

@{
    ViewData["Title"] = "Detalles del Empleado";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewData["EntityIcon"] = "fa fa-user";
    ViewData["ListTitle"] = "Detalles del Empleado";
    ViewData["IndexInfo"] = "Información del empleado y horarios de trabajo";
}

@if (Model?.Employee == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El empleado no fue encontrado. <a asp-action="Index">Volver a la lista</a></p>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary">
                <div class="card-header with-border" style="background: linear-gradient(135deg, #3c8dbc 0%, #367fa9 100%); color: white; border-radius: 3px 3px 0 0;">
                    <h4 class="card-title"><i class="fa fa-user"></i> Información del Empleado</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-row" style="padding: 10px; border-bottom: 1px solid #f4f4f4;">
                                <div class="detail-label text-muted"><i class="fa fa-user"></i> Nombre Completo</div>
                                <div class="detail-value"><strong>@Model.Employee.FullName</strong></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-row" style="padding: 10px; border-bottom: 1px solid #f4f4f4;">
                                <div class="detail-label text-muted"><i class="fa fa-id-card"></i> Identificación</div>
                                <div class="detail-value">@Model.Employee.Identification</div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-row" style="padding: 10px; border-bottom: 1px solid #f4f4f4;">
                                <div class="detail-label text-muted"><i class="fa fa-phone"></i> Teléfono</div>
                                <div class="detail-value">@Model.Employee.ContactNumber</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-row" style="padding: 10px; border-bottom: 1px solid #f4f4f4;">
                                <div class="detail-label text-muted"><i class="fa fa-envelope"></i> Email</div>
                                <div class="detail-value">@Model.Employee.EmailAddress</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-action="Create" asp-controller="EmployeeSchedules" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-success"><i class="fa fa-calendar-plus-o"></i> Agregar Horario</a>
                    <a asp-action="Edit" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-primary"><i class="fa fa-pencil"></i> Editar</a>
                    <a asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Volver</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-info">
        <div class="card-header with-border" style="background: linear-gradient(135deg, #00c0ef 0%, #00a7d0 100%); color: white; border-radius: 3px 3px 0 0;">
            <h4 class="card-title"><i class="fa fa-calendar"></i> Horarios de Trabajo</h4>
        </div>
        <div class="card-body">
            @if (Model.EmployeeSchedule == null || !Model.EmployeeSchedule.Any())
            {
                <div class="callout callout-info">
                    <h4><i class="icon fa fa-info"></i> Sin Horarios</h4>
                    <p>No se encontraron horarios para este empleado.
                    <a asp-action="Create" asp-controller="EmployeeSchedules" asp-route-id="@Model.Employee.EmployeeId" class="alert-link"><strong>Agregar el primer horario</strong></a>.</p>
                </div>
            }
            else
            {
                <table class="table table-hover table-striped" style="width:100%">
                    <thead style="background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);">
                        <tr>
                            <th style="width: 100px;">Acciones</th>
                            <th>Día</th>
                            <th>Mes</th>
                            <th>Año</th>
                            <th>Fecha Completa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.EmployeeSchedule)
                        {
                            <tr>
                                <td>
                                    <div class="btn-group">
                                        <a asp-controller="EmployeeSchedules" asp-action="Details" asp-route-id="@item.EmployeeScheduleId" class="btn btn-primary btn-sm" title="Ver Detalles"><i class="fa fa-eye"></i></a>
                                        <a asp-controller="EmployeeSchedules" asp-action="Delete" asp-route-id="@item.EmployeeScheduleId" class="btn btn-danger btn-sm" title="Eliminar"><i class="fa fa-trash"></i></a>
                                    </div>
                                </td>
                                <td>@item.AvaliableDay.Day</td>
                                <td>@item.AvaliableDay.ToString("MMMM")</td>
                                <td>@item.AvaliableDay.Year</td>
                                <td><strong>@item.AvaliableDay.ToString("dd/MM/yyyy")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}