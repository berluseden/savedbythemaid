@model JempSoft.Core.Models.Employee

@{
    ViewData["Title"] = "Eliminar Empleado";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewData["EntityIcon"] = "fa fa-user-times";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El empleado no fue encontrado. <a asp-action="Index">Volver a la lista</a></p>
    </div>
}
else
{
    <dl class="dl-horizontal">
        <dt><i class="fa fa-user text-muted"></i> Nombre</dt>
        <dd><strong>@Model.FirstName @Model.LastName</strong></dd>
        
        <dt><i class="fa fa-id-card text-muted"></i> Identificación</dt>
        <dd>@Model.Identification</dd>
        
        <dt><i class="fa fa-phone text-muted"></i> Teléfono</dt>
        <dd>@Model.ContactNumber</dd>
        
        <dt><i class="fa fa-envelope text-muted"></i> Email</dt>
        <dd>@Model.EmailAddress</dd>
        
        <dt><i class="fa fa-lock text-muted"></i> Cuenta de Usuario</dt>
        <dd>@(Model.User?.UserName ?? "Sin cuenta vinculada")</dd>
        
        <dt><i class="fa fa-check-circle text-muted"></i> Estado</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="label label-success">Activo</span>
            } else {
                <span class="label label-danger">Inactivo</span>
            }
        </dd>
    </dl>
    
    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
}
