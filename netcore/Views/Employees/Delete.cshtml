@model JempSoft.Core.Models.Employee

@{
    ViewData["Title"] = "Eliminar Empleado";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewBag.EntityName = "Empleado";
    ViewBag.EntityNamePlural = "Empleados";
    ViewBag.EntityId = Model?.EmployeeId;
}

@if (Model == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>El empleado no fue encontrado. <a asp-action="Index">Volver a la lista</a></div>
    </div>
}
else
{
    <input type="hidden" asp-for="EmployeeId" />
    
    <dl class="row">
        <dt class="col-sm-3"><i class="bi bi-person me-1"></i> Nombre</dt>
        <dd class="col-sm-9"><strong>@Model.FirstName @Model.LastName</strong></dd>
        
        <dt class="col-sm-3"><i class="bi bi-card-text me-1"></i> Identificación</dt>
        <dd class="col-sm-9">@Model.Identification</dd>
        
        <dt class="col-sm-3"><i class="bi bi-telephone me-1"></i> Teléfono</dt>
        <dd class="col-sm-9">@Model.ContactNumber</dd>
        
        <dt class="col-sm-3"><i class="bi bi-envelope me-1"></i> Email</dt>
        <dd class="col-sm-9">@Model.EmailAddress</dd>
        
        <dt class="col-sm-3"><i class="bi bi-person-lock me-1"></i> Cuenta de Usuario</dt>
        <dd class="col-sm-9">@(Model.User?.UserName ?? "Sin cuenta vinculada")</dd>
        
        <dt class="col-sm-3"><i class="bi bi-toggle-on me-1"></i> Estado</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive) {
                <span class="badge bg-success">Activo</span>
            } else {
                <span class="badge bg-danger">Inactivo</span>
            }
        </dd>
    </dl>
}
