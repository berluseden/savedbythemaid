@model IEnumerable<netcore.Models.Employee>

@{
    ViewData["Title"] = "Empleadas";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewBag.EntityName = "Empleada";
    ViewBag.EntityNamePlural = "Empleadas";
    ViewBag.ListTitle = "Gestión de Empleadas";
    ViewBag.CreateLabel = "Nueva Empleada";
    ViewBag.IndexInfo = "Administra el personal de limpieza. Puedes crear horarios, editar información y gestionar cada empleada.";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@ViewBag.SuccessMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@ViewBag.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>No hay empleadas registradas. <a asp-action="Create" class="alert-link">Registrar primera empleada</a></div>
    </div>
}
else
{
<table class="table table-hover table-striped" style="width:100%">
    <thead class="table-dark">
        <tr>
            <th style="width: 180px;">Acciones</th>
            <th><i class="bi bi-person"></i> Nombre</th>
            <th><i class="bi bi-person"></i> Apellido</th>
            <th><i class="bi bi-card-text"></i> Identificación</th>
            <th><i class="bi bi-telephone"></i> Teléfono</th>
            <th><i class="bi bi-envelope"></i> Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                <div class="btn-group">
                    <a asp-action="Create" asp-controller="EmployeeSchedules" asp-route-id="@item.EmployeeId" class="btn btn-success btn-sm" title="Agregar Horario">
                        <i class="bi bi-calendar-plus"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-warning btn-sm" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.EmployeeId" class="btn btn-info btn-sm" title="Ver Detalles">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.EmployeeId" class="btn btn-danger btn-sm" title="Eliminar">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </td>
            <td><strong>@item.FirstName</strong></td>
            <td>@item.LastName</td>
            <td><code>@item.Identification</code></td>
            <td>@item.ContactNumber</td>
            <td>@item.EmailAddress</td>
        </tr>
        }
    </tbody>
</table>
}
