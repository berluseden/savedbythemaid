@model IEnumerable<JempSoft.Core.Models.Invent.TransferIn>

@{
    ViewData["Title"] = "Entradas de Inventario";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewBag.EntityName = "Entrada";
    ViewBag.EntityNamePlural = "Entradas de Inventario";
    ViewBag.EntityIcon = "bi bi-box-arrow-in-left";
}


<table class="table table-hover table-striped" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.transferInNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.transferInDate)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.description)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.branchIdFrom)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.warehouseIdFrom)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.branchIdTo)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.warehouseIdTo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.transferOrder)
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Details" asp-route-id="@item.transferInId" class="btn btn-primary btn-sm" title="Ver detalles"><i class="bi bi-eye"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.transferInId" class="btn btn-warning btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.transferInId" class="btn btn-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></a>
                </div>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.transferInNumber)
            </td>
            <td>
                @item.transferInDate.Date.ToString("dd-MMM-yyyy")
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.description)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.branchIdFrom)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.warehouseIdFrom)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.branchIdTo)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.warehouseIdTo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.transferOrder.transferOrderNumber)
            </td>

        </tr>
        }
    </tbody>
</table>
