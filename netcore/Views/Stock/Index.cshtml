@using JempSoft.Core.Models.Invent
@inject netcore.Data.ApplicationDbContext Context
@inject netcore.Services.INetcoreService Svc
@{
    ViewData["Title"] = "Inventario en Tiempo Real";
    Layout = "_AdminLTE4";
    
    List<VMStock> stocks = new List<VMStock>();
    stocks = Svc.GetStockPerWarehouse();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="bi bi-house"></i> Inicio</a></li>
                        <li class="breadcrumb-item active">Inventario</li>
                    </ol>
                </nav>
                <h2 class="mb-0">
                    <i class="bi bi-box-seam text-primary me-2"></i>
                    Inventario en Tiempo Real
                </h2>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title"><i class="bi bi-boxes me-2"></i> Stock por Almacén</h3>
                    <div class="card-tools">
                        <div class="btn-group">
                            <button type="button" id="btn-export-excel" class="btn btn-success btn-sm" title="Exportar a Excel">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel
                            </button>
                            <button type="button" id="btn-export-pdf" class="btn btn-danger btn-sm" title="Exportar a PDF">
                                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                            </button>
                            <button type="button" id="btn-export-csv" class="btn btn-primary btn-sm" title="Exportar a CSV">
                                <i class="bi bi-file-earmark-text me-1"></i> CSV
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped" style="width:100%">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="bi bi-tag"></i> Producto</th>
                                    <th><i class="bi bi-building"></i> Almacén</th>
                                    <th><i class="bi bi-box-arrow-in-down"></i> Recibido</th>
                                    <th><i class="bi bi-truck"></i> Enviado</th>
                                    <th><i class="bi bi-arrow-down-circle"></i> Transf. Entrada</th>
                                    <th><i class="bi bi-arrow-up-circle"></i> Transf. Salida</th>
                                    <th class="text-success"><i class="bi bi-check-circle"></i> En Mano</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in stocks)
                                {
                                    <tr>
                                        <td><strong>@item.Product</strong></td>
                                        <td>@item.Warehouse</td>
                                        <td><span class="badge bg-info">@item.QtyReceiving</span></td>
                                        <td><span class="badge bg-warning text-dark">@item.QtyShipment</span></td>
                                        <td><span class="badge bg-success">@item.QtyTransferIn</span></td>
                                        <td><span class="badge bg-danger">@item.QtyTransferOut</span></td>
                                        <td><strong class="text-success">@item.QtyOnhand</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Styles{

}


@section Scripts{
    <!-- ChartJS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function () {
            var mainTable;

            mainTable = $('.table').DataTable({
                "lengthChange": false,
                "info": false,
                "searching": true,
                "dom": 'lrtip',
                "scrollX": false,
                "buttons": [
                                { 
                                    extend: 'csv',
                                    filename: 'stock-csv'
                                },
                                { 
                                    extend: 'pdf',      
                                    filename: 'stock-pdf'
                                },
                                { 
                                    extend: 'excel',
                                    filename: 'stock-excel'
                                }
                        ]
            });

            $('#mainSearch').keyup(function () {
                mainTable.search($(this).val()).draw();
            });


            $("#btn-export-csv").on("click", function () {
                mainTable.button('.buttons-csv').trigger();
            })

            $("#btn-export-excel").on("click", function () {
                mainTable.button('.buttons-excel').trigger();
            })

            $("#btn-export-pdf").on("click", function () {
                mainTable.button('.buttons-pdf').trigger();
            })



        });




    </script>
}


