@model JempSoft.Core.Models.ServiceType

@{
    ViewData["Title"] = "Detalles del Tipo de Servicio";
    Layout = "~/Views/Shared/_AdminLTE4Details.cshtml";
    ViewData["EntityIcon"] = "fa fa-tags";
    ViewData["DetailsTitle"] = "Tipo de Servicio";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El tipo de servicio no fue encontrado.</p>
        <a asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Volver</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-tag text-muted"></i> Título</div>
                <div class="detail-value"><strong>@Model.Title</strong></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-money text-muted"></i> Costo</div>
                <div class="detail-value"><span class="text-muted">$@Model.Cost.ToString("N2")</span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-dollar text-muted"></i> Precio</div>
                <div class="detail-value"><span class="label label-success" style="font-size: 14px;">$@Model.Price.ToString("N2")</span></div>
            </div>
        </div>
    </div>
    
    <div class="row" style="margin-top: 15px;">
        <div class="col-md-4">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-check-circle text-muted"></i> Estado</div>
                <div class="detail-value">
                    @if (Model.IsActive) {
                        <span class="label label-success"><i class="fa fa-check"></i> Activo</span>
                    } else {
                        <span class="label label-danger"><i class="fa fa-times"></i> Inactivo</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-calendar text-muted"></i> Creación</div>
                <div class="detail-value">@Model.CreationDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="detail-row">
                <div class="detail-label"><i class="fa fa-refresh text-muted"></i> Actualización</div>
                <div class="detail-value">@(Model.UpdateDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
            </div>
        </div>
    </div>
}
