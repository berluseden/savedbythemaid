@model JempSoft.Core.Models.ServiceType

@{
    ViewData["Title"] = "Eliminar Tipo de Servicio";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewBag.EntityName = "Tipo de Servicio";
    ViewBag.EntityNamePlural = "Tipos de Servicio";
    ViewBag.EntityId = Model?.ServiceTypeId;
}

@if (Model == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>El tipo de servicio no fue encontrado.</div>
    </div>
}
else
{
    <input type="hidden" asp-for="ServiceTypeId" />
    
    <dl class="row">
        <dt class="col-sm-3"><i class="bi bi-tag me-1"></i> Título</dt>
        <dd class="col-sm-9"><strong>@Model.Title</strong></dd>
        
        <dt class="col-sm-3"><i class="bi bi-currency-dollar me-1"></i> Costo</dt>
        <dd class="col-sm-9">$@Model.Cost.ToString("N2")</dd>
        
        <dt class="col-sm-3"><i class="bi bi-cash me-1"></i> Precio</dt>
        <dd class="col-sm-9"><span class="badge bg-success">$@Model.Price.ToString("N2")</span></dd>
        
        <dt class="col-sm-3"><i class="bi bi-toggle-on me-1"></i> Estado</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive) {
                <span class="badge bg-success">Activo</span>
            } else {
                <span class="badge bg-danger">Inactivo</span>
            }
        </dd>
    </dl>
}
