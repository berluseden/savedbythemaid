@model JempSoft.Core.Models.ServiceType

@{
    ViewData["Title"] = "Eliminar Tipo de Servicio";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewData["EntityIcon"] = "fa fa-tags";
}

@if (Model == null)
{
    <div class="callout callout-warning">
        <h4><i class="icon fa fa-warning"></i> No Encontrado</h4>
        <p>El tipo de servicio no fue encontrado.</p>
    </div>
}
else
{
    <dl class="dl-horizontal">
        <dt><i class="fa fa-tag text-muted"></i> Título</dt>
        <dd><strong>@Model.Title</strong></dd>
        
        <dt><i class="fa fa-money text-muted"></i> Costo</dt>
        <dd>$@Model.Cost.ToString("N2")</dd>
        
        <dt><i class="fa fa-dollar text-muted"></i> Precio</dt>
        <dd><span class="label label-success">$@Model.Price.ToString("N2")</span></dd>
        
        <dt><i class="fa fa-check-circle text-muted"></i> Estado</dt>
        <dd>
            @if (Model.IsActive) {
                <span class="label label-success">Activo</span>
            } else {
                <span class="label label-danger">Inactivo</span>
            }
        </dd>
    </dl>
    
    <input type="hidden" name="ServiceTypeId" value="@Model.ServiceTypeId" />
}
