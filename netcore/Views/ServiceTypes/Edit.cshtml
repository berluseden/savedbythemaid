@model JempSoft.Core.Models.ServiceType

@{
    ViewData["Title"] = "Editar Tipo de Servicio";
    Layout = "~/Views/Shared/_AdminLTE4Edit.cshtml";
    ViewData["EntityIcon"] = "fa fa-tags";
    ViewData["FormTitle"] = "Editar Tipo de Servicio";
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        <h4><i class="icon fa fa-ban"></i> Error</h4>
        @ViewBag.ErrorMessage
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="ServiceTypeId" />
        <input type="hidden" asp-for="CreatorUserId" />
        <input type="hidden" asp-for="CreationDate" />
        
        <div class="form-group">
            <label asp-for="Title" class="control-label"><i class="fa fa-tag text-muted"></i> Nombre del Servicio <span class="text-danger">*</span></label>
            <input asp-for="Title" class="form-control" placeholder="Ej: Limpieza General" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Cost" class="control-label"><i class="fa fa-money text-muted"></i> Costo <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-addon">$</span>
                        <input asp-for="Cost" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="Cost" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Price" class="control-label"><i class="fa fa-dollar text-muted"></i> Precio de Venta <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-addon">$</span>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <div class="form-group">
            <div class="checkbox">
                <label style="font-weight: 600;">
                    <input asp-for="IsActive" /> <i class="fa fa-check-circle text-success"></i> Activo
                </label>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
