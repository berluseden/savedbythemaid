@model JempSoft.Core.Models.Invent.TransferOut

@{
    ViewData["Title"] = "Eliminar Salida";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewBag.EntityName = "Salida de Inventario";
    ViewBag.EntityNamePlural = "Salidas de Inventario";
    ViewBag.EntityId = Model.transferOutId;
}

<input type="hidden" asp-for="transferOutId" />

<dl class="row">
    <dt class="col-sm-3">
        <i class="bi bi-hash me-1"></i> @Html.DisplayNameFor(model => model.transferOutNumber)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.transferOutNumber)
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-calendar me-1"></i> @Html.DisplayNameFor(model => model.transferOutDate)
    </dt>
    <dd class="col-sm-9">
        @Model.transferOutDate.ToString("dd/MM/yyyy")
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-text-paragraph me-1"></i> @Html.DisplayNameFor(model => model.description)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.description)
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-building me-1"></i> Sucursal Origen
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.branchFrom.branchName)
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-box-seam me-1"></i> Almacén Origen
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.warehouseFrom.warehouseName)
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-building me-1"></i> Sucursal Destino
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.branchTo.branchName)
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-box-seam me-1"></i> Almacén Destino
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.warehouseTo.warehouseName)
    </dd>
    <dt class="col-sm-3">
        <i class="bi bi-file-earmark-text me-1"></i> Orden de Transferencia
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.transferOrder.transferOrderNumber)
    </dd>
</dl>
