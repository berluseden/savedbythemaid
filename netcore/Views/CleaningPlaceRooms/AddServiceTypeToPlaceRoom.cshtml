@model netcore.VMs.PlaceRoomsServiceTypesVM
@{
    ViewData["Title"] = "Agregar Servicios";
    Layout = "~/Views/Shared/_AdminLTE4Edit.cshtml";
    ViewBag.EntityName = "Servicio";
    ViewBag.EntityNamePlural = "Tipos de Habitación";

    ViewBag.ControllerActionView = "AddServiceToPlaceRoom";

    var serviceTypes = ViewBag.ServiceTypes;
}


<div class="row">
    <div class="col-md-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="CleaningPlaceRooms.CleaningPlaceRoomId" />


        <div class="form-group">
            <label asp-for="CleaningPlaceRooms.Title" class="control-label"></label>
            <input asp-for="CleaningPlaceRooms.Title" class="form-control" readonly />
            <span asp-validation-for="CleaningPlaceRooms.Title" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-12">
            <div class="form-group">
                <label asp-for="ServiceTypes" class="control-label">Services</label>

                @*<select asp-for="CleaningPlaceRooms" class="form-control select2"
                            asp-items="cleaningPlaceRooms">
                    </select>*@

                <select id="multiple" asp-for="ServiceTypesIds" class="select2 form-control" asp-items="serviceTypes"></select>


                <span asp-validation-for="ServiceTypes" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<table class="table table-hover table-striped" style="width:100%">
    <thead>
        <tr>
            <th style="text-align: center">
                Aggregate Services
            </th>
        </tr>
    </thead>
   
</table>
<div class="row">

    <table class="table table-hover table-striped" style="width:100%">
        <thead>
            <tr>
                <th></th>
                <th>
                    Title
                </th>

                <th>
                    IsActive
                </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ServiceTypesddeds)
            {
                <tr>
                    <td>
                        <div class="tools">
                            <a asp-action="AddServiceTypeToPlaceRoom" asp-route-id="@item.ServiceTypeId" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i></a>

                        </div>

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FullDescription)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.IsActive)
                    </td>

                </tr>
            }
        </tbody>
    </table>














    
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
