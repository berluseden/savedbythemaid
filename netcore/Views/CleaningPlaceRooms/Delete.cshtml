@model netcore.Models.CleaningPlaceRoom

@{
    ViewData["Title"] = "Eliminar Tipo de Habitación";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewBag.EntityName = "Tipo de Habitación";
    ViewBag.EntityNamePlural = "Tipos de Habitación";
    ViewBag.EntityId = Model?.CleaningPlaceRoomId;
}

@if (Model == null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>El tipo de habitación no fue encontrado.</div>
    </div>
}
else
{
    <input type="hidden" asp-for="CleaningPlaceRoomId" />
    
    <dl class="row">
        <dt class="col-sm-3"><i class="bi bi-grid-3x3 me-1"></i> Título</dt>
        <dd class="col-sm-9"><strong>@Model.Title</strong></dd>
        
        <dt class="col-sm-3"><i class="bi bi-toggle-on me-1"></i> Estado</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive) {
                <span class="badge bg-success">Activo</span>
            } else {
                <span class="badge bg-danger">Inactivo</span>
            }
        </dd>
        
        <dt class="col-sm-3"><i class="bi bi-calendar me-1"></i> Creación</dt>
        <dd class="col-sm-9">@Model.CreationDate.ToString("dd/MM/yyyy")</dd>
    </dl>
}
