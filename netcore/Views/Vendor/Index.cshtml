@model IEnumerable<JempSoft.Applications.Invent.Dto.VendorOutputDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLTE4Index.cshtml";
    ViewData["EntityIcon"] = "fa fa-industry";
    ViewData["ListTitle"] = "Vendor List";
    ViewData["IndexInfo"] = "Vendor is an organization that supplies products to your company. Your company buy products from them.";
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <h4><i class="icon fa fa-info"></i> No Vendors Found</h4>
        There are no vendors registered yet. <a asp-action="Create" class="alert-link">Create your first vendor</a> to start managing your suppliers.
    </div>
}
else
{
<table class="table table-hover table-striped" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.VendorName)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Size)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Street1)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Street2)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Province)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.Country)
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                <div class="tools">
                    <a asp-action="Edit" asp-route-id="@item.VendorId" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i></a>
                    <a asp-action="Details" asp-route-id="@item.VendorId" class="btn btn-primary btn-sm"><i class="fa fa-list"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.VendorId" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></a>
                </div>
                
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VendorName)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Size)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Street1)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Street2)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Province)
            </td>
            <td class="hidden">
                @Html.DisplayFor(modelItem => item.Country)
            </td>

        </tr>
        }
    </tbody>
</table>
}
