@model netcore.Models.ServiceMeet

@{
    ViewData["Title"] = "Eliminar Cita de Servicio";
    Layout = "~/Views/Shared/_AdminLTE4Delete.cshtml";
    ViewBag.EntityName = "Cita de Servicio";
    ViewBag.EntityNamePlural = "Citas de Servicio";
    ViewBag.EntityId = Model?.ServiceMeetId;
}

<input type="hidden" asp-for="ServiceMeetId" />

<dl class="row">
    <dt class="col-sm-3"><i class="bi bi-bookmark me-1"></i> @Html.DisplayNameFor(model => model.Title)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>
    
    <dt class="col-sm-3"><i class="bi bi-geo-alt me-1"></i> @Html.DisplayNameFor(model => model.Address)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>
    
    <dt class="col-sm-3"><i class="bi bi-calendar3 me-1"></i> Fecha</dt>
    <dd class="col-sm-9">@Model.Day/@Model.Month/@Model.Year</dd>
    
    <dt class="col-sm-3"><i class="bi bi-clock me-1"></i> Hora</dt>
    <dd class="col-sm-9">@Model.Hour:@Model.Minute.ToString("D2") @(Model.isMorning ? "AM" : "PM")</dd>
</dl>
