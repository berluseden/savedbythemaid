<script>
    $(function () {

        var bookObj = {
            CleaningPlaceId : 0,
            CleaningPlaceRoomId : 0,
            ServiceTypeId : 0
        };

        var btnBook = document.getElementById('btnBook');
        var cartItemId = null;

        fillCleaningPlaces();
        IsAuthenticated();

        $("#selectCleaningPlace").click(function () {

            length = $('#selectCleaningPlace').children('option').length;

            if (length <= 1) {
                fillCleaningPlaces();
            }
        })

        $("#selectCleaningPlace").change(function () {


            var id = document.getElementById('selectCleaningPlace').value;

            fillCleaningPlaceRoomsByCleaningPlaceId(id);

        });

        function fillCleaningPlaces() {
                        
            $.get("/Booking/GetAllCleaningPlace", null, function (data) {

                $.each(data.cleaningPlaces, function (key, entry) {

                    $('#selectCleaningPlace').append($('<option></option>').attr('value', entry.id).text(entry.title));
                })
            });
        }

        function fillCleaningPlaceRoomsByCleaningPlaceId(id) {

            $('#selectCleaningPlaceRoom').empty();

            $('#selectCleaningPlaceRoom').append($('<option></option>').attr('value', 0).text('Choose...'));

            $.get("/Booking/GetRoomsByCleaningPlaceId?Id=" + id, null, function (data) {

                $.each(data.cleaningPlaceRooms, function (key, entry) {

                    $('#selectCleaningPlaceRoom').append($('<option></option>').attr('value', entry.id).text(entry.title));
                })
            });
        }

        $("#selectCleaningPlaceRoom").change(function () {


            var id = document.getElementById('selectCleaningPlaceRoom').value;

            fillServiceTypeByCleaningRoomId(id);

        });

        function fillServiceTypeByCleaningRoomId(id) {

            $('#selectServiceType').empty();

            $('#selectServiceType').append($('<option></option>').attr('value', 0).text('Choose Service Type.'));

            $.get("/Booking/GetServiceTypeByPlaceRoomsId?Id=" + id, null, function (data) {

                $.each(data.cleaningPlaceRooms, function (key, entry) {

                    $('#selectServiceType').append($('<option></option>').attr('value', entry.id).text(entry.title));
                })
            });
        }

        $('#btnBook').click(function () {

            btnBook.value = 'Booking';
            btnBook.disabled = true;

            var name = document.getElementById('name');
            var email = document.getElementById('email');
            var phone = document.getElementById('phone');
            var address = document.getElementById('address');
            var additionalInfo = document.getElementById('additionalInfo');

            setCookie('name', name.value, 3);
            setCookie('email', email.value, 3);
            setCookie('phone', phone.value, 3);
            setCookie('address', address.value, 3);
            setCookie('additionalInfo', additionalInfo.value, 3);

            localStorage.Name = name.value;
            localStorage.Email = email.value;
            localStorage.Phone = phone.value;
            localStorage.Address = address.value;
            localStorage.AdditionalInfo = additionalInfo.value;

            processToCheckOut();
        })

        function processToCheckOut() {

            bookObj.CleaningPlaceId = parseInt(document.getElementById('selectCleaningPlace').value);
            bookObj.CleaningPlaceRoomId = parseInt(document.getElementById('selectCleaningPlaceRoom').value);
            bookObj.ServiceTypeId = parseInt(document.getElementById('selectServiceType').value);

            $.post("/Booking/Book/", bookObj,
                function (data, status) {

                    console.log('data: ' + JSON.stringify(data));
                    cartItemId = JSON.stringify(data.cartItemId);

                    setCookie("cartItemId", cartItemId, 3);

                    if (IsAuthenticated()) {

                        window.location.href = "/Booking/ProcessToCheckOut?id=" + cartItemId;
                    }
                    else {

                        window.location.href = "/Account/Login/?returnUrl=" + "/Booking/ProcessToCheckOut?id=" + cartItemId;
                    }


                    if (status === 'success') {
                        return console.log(JSON.stringify(data.cartItemId));
                    }
                    alert("Data: " + data + "\nStatus: " + status);
                });
        }

        function hasPendingOrders()
        {
            $.get("/Booking/HasPendingOrders?email=" + email, null, function (data) {

            });
        }

        function IsAuthenticated() {

            var userAuthorized = @User.Identity.IsAuthenticated.ToString().ToLower();
            console.log('Authorized? ' + userAuthorized);
            if (userAuthorized === 'True') {
                return true;
            }
            return false;
        }
    });
</script>
