@* ============================================
   🦶 CUSTOMER PORTAL - Footer
   Modern footer with gradient design
   ============================================ *@

<footer class="customer-footer">
    <div class="container">
        <div class="row g-5">
            <!-- Brand Column -->
            <div class="col-lg-4 col-md-6">
                <div class="footer-brand">
                    <i class="bi bi-house-heart-fill"></i>
                    SavedByTheMaid
                </div>
                <p class="footer-description">
                    Servicio profesional de limpieza para hogares y oficinas. 
                    Calidad garantizada, resultados impecables.
                </p>
                <div class="footer-social">
                    <a href="#" title="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                </div>
            </div>
            
            <!-- Quick Links -->
            <div class="col-lg-2 col-md-6">
                <h4 class="footer-title">Navegación</h4>
                <ul class="footer-links">
                    <li><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                    <li><a href="@Url.Action("About", "Home")">Nosotros</a></li>
                    <li><a href="@Url.Action("Services", "Home")">Servicios</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Contacto</a></li>
                    <li><a href="@Url.Action("Schedule", "Booking")">Reservar</a></li>
                </ul>
            </div>
            
            <!-- Services -->
            <div class="col-lg-3 col-md-6">
                <h4 class="footer-title">Servicios</h4>
                <ul class="footer-links">
                    <li><a href="#">Limpieza de Hogar</a></li>
                    <li><a href="#">Limpieza de Oficinas</a></li>
                    <li><a href="#">Limpieza Profunda</a></li>
                    <li><a href="#">Post-Construcción</a></li>
                    <li><a href="#">Mudanzas</a></li>
                </ul>
            </div>
            
            <!-- Contact -->
            <div class="col-lg-3 col-md-6">
                <h4 class="footer-title">Contacto</h4>
                <div class="footer-contact-item">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>123 Main Street<br>Miami, FL 33101</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-telephone-fill"></i>
                    <span>+1 (305) 555-0123</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-envelope-fill"></i>
                    <span>info@@savedbythemaid.com</span>
                </div>
                <div class="footer-contact-item">
                    <i class="bi bi-clock-fill"></i>
                    <span>Lun - Sáb: 7:00 AM - 8:00 PM</span>
                </div>
            </div>
        </div>
        
        <!-- Newsletter -->
        <div class="row mt-5">
            <div class="col-lg-6 mx-auto">
                <div class="newsletter-box text-center p-4 rounded-4" style="background: rgba(255,255,255,0.05);">
                    <h5 class="mb-3">📧 Suscríbete a nuestro boletín</h5>
                    <p class="text-muted mb-3">Recibe ofertas exclusivas y consejos de limpieza</p>
                    <form class="d-flex gap-2 justify-content-center flex-wrap">
                        <input type="email" class="form-control" placeholder="Tu correo electrónico" 
                               style="max-width: 300px; border-radius: 50px; padding: 0.75rem 1.5rem;">
                        <button type="submit" class="btn-primary-gradient">
                            <i class="bi bi-send me-1"></i> Suscribirse
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Bottom -->
        <div class="footer-bottom">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start text-center mb-3 mb-md-0">
                    &copy; @DateTime.Now.Year <strong>SavedByTheMaid</strong>. Todos los derechos reservados.
                </div>
                <div class="col-md-6 text-md-end text-center">
                    <a href="#" class="text-muted text-decoration-none me-3">Política de Privacidad</a>
                    <a href="#" class="text-muted text-decoration-none">Términos de Servicio</a>
                </div>
            </div>
        </div>
    </div>
</footer>
