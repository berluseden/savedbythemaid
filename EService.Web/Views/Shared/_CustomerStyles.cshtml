@* ============================================
   🎨 CUSTOMER PORTAL - Modern Styles 2026
   Glassmorphism + Gradients + Animations
   ============================================ *@

<style>
    /* ============================================
       🎨 CSS Variables & Theme System
       ============================================ */
    :root {
        /* Brand Colors */
        --brand-primary: #667eea;
        --brand-secondary: #764ba2;
        --brand-accent: #f093fb;
        --brand-success: #38ef7d;
        --brand-warning: #f2c94c;
        
        /* Gradients */
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --gradient-success: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        --gradient-hero: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
        --gradient-clean: linear-gradient(135deg, #74ebd5 0%, #ACB6E5 100%);
        --gradient-fresh: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --gradient-sky: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%);
        
        /* Glassmorphism */
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-bg-dark: rgba(255, 255, 255, 0.95);
        --glass-border: rgba(255, 255, 255, 0.5);
        --glass-shadow: 0 8px 32px rgba(31, 38, 135, 0.15);
        --glass-blur: blur(20px);
        
        /* Shadows */
        --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 25px rgba(0, 0, 0, 0.08);
        --shadow-lg: 0 15px 50px rgba(0, 0, 0, 0.12);
        --shadow-xl: 0 25px 80px rgba(0, 0, 0, 0.18);
        --shadow-glow: 0 0 40px rgba(102, 126, 234, 0.4);
        
        /* Typography */
        --font-primary: 'Inter', -apple-system, sans-serif;
        --font-display: 'Poppins', sans-serif;
        
        /* Transitions */
        --transition-fast: 0.2s ease;
        --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-bounce: 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        
        /* Border Radius */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 20px;
        --radius-xl: 30px;
        --radius-full: 9999px;
    }
    
    /* ============================================
       🔤 Base & Typography
       ============================================ */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    html {
        scroll-behavior: smooth;
    }
    
    body {
        font-family: var(--font-primary);
        background: #f8fafc;
        color: #1f2937;
        line-height: 1.7;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }
    
    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -0.02em;
    }
    
    /* ============================================
       🎨 Animated Background
       ============================================ */
    .animated-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
    }
    
    .gradient-sphere {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        animation: float 20s infinite ease-in-out;
    }
    
    .sphere-1 {
        width: 600px;
        height: 600px;
        background: var(--gradient-primary);
        top: -200px;
        left: -100px;
        animation-delay: 0s;
    }
    
    .sphere-2 {
        width: 500px;
        height: 500px;
        background: var(--gradient-fresh);
        bottom: -150px;
        right: -100px;
        animation-delay: -7s;
    }
    
    .sphere-3 {
        width: 400px;
        height: 400px;
        background: var(--gradient-sky);
        top: 40%;
        right: 20%;
        animation-delay: -14s;
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
        25% { transform: translateY(-30px) rotate(5deg) scale(1.05); }
        50% { transform: translateY(0) rotate(0deg) scale(1); }
        75% { transform: translateY(30px) rotate(-5deg) scale(0.95); }
    }
    
    /* ============================================
       🧭 Navigation
       ============================================ */
    .customer-navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        padding: 1rem 0;
        transition: var(--transition-base);
    }
    
    .customer-navbar.scrolled {
        background: var(--glass-bg-dark);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow: var(--shadow-md);
        padding: 0.75rem 0;
    }
    
    .navbar-brand {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 800;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .navbar-brand i {
        font-size: 2rem;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .nav-link {
        font-weight: 600;
        color: #374151 !important;
        padding: 0.75rem 1.25rem !important;
        border-radius: var(--radius-full);
        transition: var(--transition-base);
        position: relative;
    }
    
    .nav-link:hover {
        color: var(--brand-primary) !important;
        background: rgba(102, 126, 234, 0.1);
    }
    
    .nav-link.active {
        color: white !important;
        background: var(--gradient-primary);
    }
    
    .btn-book-now {
        background: var(--gradient-primary);
        color: white !important;
        padding: 0.75rem 2rem !important;
        border-radius: var(--radius-full);
        font-weight: 700;
        box-shadow: var(--shadow-md);
        transition: var(--transition-base);
        border: none;
    }
    
    .btn-book-now:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-glow);
        color: white !important;
    }
    
    /* Cart Badge */
    .cart-badge {
        position: relative;
    }
    
    .cart-badge .badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: var(--gradient-secondary);
        font-size: 0.65rem;
        padding: 0.35em 0.6em;
        border-radius: var(--radius-full);
        animation: pulse-glow 2s infinite;
    }
    
    /* ============================================
       🦸 Hero Section
       ============================================ */
    .hero-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 120px 0 80px;
        position: relative;
    }
    
    .hero-content {
        position: relative;
        z-index: 2;
    }
    
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        padding: 0.5rem 1.25rem;
        border-radius: var(--radius-full);
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--brand-primary);
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-sm);
    }
    
    .hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }
    
    .hero-title .highlight {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .hero-subtitle {
        font-size: 1.25rem;
        color: #6b7280;
        max-width: 500px;
        margin-bottom: 2.5rem;
    }
    
    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 3rem;
    }
    
    .btn-hero-primary {
        background: var(--gradient-primary);
        color: white;
        padding: 1.1rem 2.5rem;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 1.1rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        transition: var(--transition-base);
        box-shadow: var(--shadow-lg);
        text-decoration: none;
    }
    
    .btn-hero-primary:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-glow);
        color: white;
    }
    
    .btn-hero-secondary {
        background: white;
        color: var(--brand-primary);
        padding: 1.1rem 2.5rem;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 1.1rem;
        border: 2px solid var(--brand-primary);
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        transition: var(--transition-base);
        text-decoration: none;
    }
    
    .btn-hero-secondary:hover {
        background: var(--brand-primary);
        color: white;
        transform: translateY(-3px);
    }
    
    .hero-stats {
        display: flex;
        gap: 3rem;
    }
    
    .stat-item {
        text-align: center;
    }
    
    .stat-number {
        font-family: var(--font-display);
        font-size: 2.5rem;
        font-weight: 800;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .stat-label {
        font-size: 0.875rem;
        color: #6b7280;
        font-weight: 500;
    }
    
    .hero-image {
        position: relative;
    }
    
    .hero-image img {
        width: 100%;
        max-width: 600px;
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
    }
    
    .hero-float-card {
        position: absolute;
        background: var(--glass-bg-dark);
        backdrop-filter: var(--glass-blur);
        padding: 1.25rem 1.5rem;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        display: flex;
        align-items: center;
        gap: 1rem;
        animation: float 4s infinite ease-in-out;
    }
    
    .hero-float-card.card-1 {
        top: 10%;
        right: -20px;
        animation-delay: 0s;
    }
    
    .hero-float-card.card-2 {
        bottom: 15%;
        left: -30px;
        animation-delay: -2s;
    }
    
    .float-card-icon {
        width: 50px;
        height: 50px;
        border-radius: var(--radius-md);
        background: var(--gradient-success);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
    }
    
    .float-card-text h4 {
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }
    
    .float-card-text p {
        font-size: 0.8rem;
        color: #6b7280;
        margin: 0;
    }
    
    /* ============================================
       🃏 Service Cards
       ============================================ */
    .section-title {
        text-align: center;
        margin-bottom: 4rem;
    }
    
    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(102, 126, 234, 0.1);
        padding: 0.5rem 1.25rem;
        border-radius: var(--radius-full);
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--brand-primary);
        margin-bottom: 1rem;
    }
    
    .section-title h2 {
        font-size: 2.75rem;
        margin-bottom: 1rem;
    }
    
    .section-title p {
        font-size: 1.1rem;
        color: #6b7280;
        max-width: 600px;
        margin: 0 auto;
    }
    
    .service-card {
        background: var(--glass-bg-dark);
        backdrop-filter: var(--glass-blur);
        border-radius: var(--radius-xl);
        padding: 2.5rem;
        text-align: center;
        transition: var(--transition-base);
        border: 1px solid rgba(255, 255, 255, 0.5);
        height: 100%;
    }
    
    .service-card:hover {
        transform: translateY(-15px);
        box-shadow: var(--shadow-xl);
    }
    
    .service-icon {
        width: 90px;
        height: 90px;
        border-radius: var(--radius-lg);
        background: var(--gradient-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2.5rem;
        color: white;
        transition: var(--transition-base);
    }
    
    .service-card:hover .service-icon {
        transform: scale(1.1) rotate(5deg);
    }
    
    .service-card h3 {
        font-size: 1.35rem;
        margin-bottom: 1rem;
    }
    
    .service-card p {
        color: #6b7280;
        margin-bottom: 1.5rem;
    }
    
    .service-price {
        font-family: var(--font-display);
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--brand-primary);
    }
    
    .service-price small {
        font-size: 0.875rem;
        color: #9ca3af;
        font-weight: 400;
    }
    
    /* ============================================
       📅 Booking Flow
       ============================================ */
    .booking-section {
        padding: 100px 0;
    }
    
    .booking-container {
        background: var(--glass-bg-dark);
        backdrop-filter: var(--glass-blur);
        border-radius: var(--radius-xl);
        padding: 3rem;
        box-shadow: var(--shadow-xl);
    }
    
    .booking-steps {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 3rem;
    }
    
    .step-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    
    .step-number {
        width: 45px;
        height: 45px;
        border-radius: var(--radius-full);
        background: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #6b7280;
        transition: var(--transition-base);
    }
    
    .step-item.active .step-number,
    .step-item.completed .step-number {
        background: var(--gradient-primary);
        color: white;
        box-shadow: var(--shadow-glow);
    }
    
    .step-item.completed .step-number::after {
        content: '✓';
    }
    
    .step-label {
        font-weight: 600;
        color: #6b7280;
    }
    
    .step-item.active .step-label {
        color: var(--brand-primary);
    }
    
    .step-connector {
        width: 60px;
        height: 3px;
        background: #e5e7eb;
        border-radius: var(--radius-full);
    }
    
    .step-connector.active {
        background: var(--gradient-primary);
    }
    
    /* Booking Form */
    .booking-form .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }
    
    .booking-form .form-control,
    .booking-form .form-select {
        border: 2px solid #e5e7eb;
        border-radius: var(--radius-md);
        padding: 1rem 1.25rem;
        font-size: 1rem;
        transition: var(--transition-base);
        background: white;
    }
    
    .booking-form .form-control:focus,
    .booking-form .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
    }
    
    /* Service Selection Cards */
    .service-select-card {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        cursor: pointer;
        transition: var(--transition-base);
        text-align: center;
    }
    
    .service-select-card:hover {
        border-color: var(--brand-primary);
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
    }
    
    .service-select-card.selected {
        border-color: var(--brand-primary);
        background: rgba(102, 126, 234, 0.05);
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
    }
    
    .service-select-card .icon {
        width: 60px;
        height: 60px;
        border-radius: var(--radius-md);
        background: var(--gradient-clean);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.75rem;
    }
    
    .service-select-card h4 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }
    
    .service-select-card .price {
        font-weight: 700;
        color: var(--brand-primary);
    }
    
    /* Date/Time Picker */
    .date-picker-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.5rem;
    }
    
    .date-cell {
        aspect-ratio: 1;
        border: 2px solid transparent;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition-base);
        background: white;
    }
    
    .date-cell:hover:not(.disabled) {
        border-color: var(--brand-primary);
        background: rgba(102, 126, 234, 0.1);
    }
    
    .date-cell.selected {
        background: var(--gradient-primary);
        color: white;
    }
    
    .date-cell.disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    
    .time-slot {
        padding: 1rem 1.5rem;
        border: 2px solid #e5e7eb;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: var(--transition-base);
        text-align: center;
        font-weight: 600;
    }
    
    .time-slot:hover {
        border-color: var(--brand-primary);
    }
    
    .time-slot.selected {
        background: var(--gradient-primary);
        color: white;
        border-color: transparent;
    }
    
    /* ============================================
       🛒 Cart & Checkout
       ============================================ */
    .cart-item {
        background: white;
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        box-shadow: var(--shadow-sm);
        transition: var(--transition-base);
    }
    
    .cart-item:hover {
        box-shadow: var(--shadow-md);
    }
    
    .cart-item-image {
        width: 100px;
        height: 100px;
        border-radius: var(--radius-md);
        background: var(--gradient-clean);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        flex-shrink: 0;
    }
    
    .cart-item-details {
        flex: 1;
    }
    
    .cart-item-title {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }
    
    .cart-item-meta {
        color: #6b7280;
        font-size: 0.9rem;
    }
    
    .cart-item-price {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--brand-primary);
    }
    
    .cart-item-remove {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-full);
        border: none;
        background: #fee2e2;
        color: #ef4444;
        cursor: pointer;
        transition: var(--transition-base);
    }
    
    .cart-item-remove:hover {
        background: #ef4444;
        color: white;
    }
    
    .cart-summary {
        background: var(--gradient-primary);
        border-radius: var(--radius-xl);
        padding: 2rem;
        color: white;
        position: sticky;
        top: 120px;
    }
    
    .cart-summary h3 {
        margin-bottom: 1.5rem;
    }
    
    .cart-summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .cart-summary-total {
        font-size: 1.5rem;
        font-weight: 700;
        margin-top: 1rem;
    }
    
    .btn-checkout {
        width: 100%;
        background: white;
        color: var(--brand-primary);
        padding: 1.1rem;
        border-radius: var(--radius-full);
        font-weight: 700;
        font-size: 1.1rem;
        border: none;
        margin-top: 1.5rem;
        transition: var(--transition-base);
    }
    
    .btn-checkout:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }
    
    /* ============================================
       🌟 Testimonials
       ============================================ */
    .testimonial-card {
        background: var(--glass-bg-dark);
        backdrop-filter: var(--glass-blur);
        border-radius: var(--radius-xl);
        padding: 2.5rem;
        height: 100%;
    }
    
    .testimonial-stars {
        color: #fbbf24;
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }
    
    .testimonial-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #374151;
        margin-bottom: 1.5rem;
    }
    
    .testimonial-author {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .testimonial-avatar {
        width: 55px;
        height: 55px;
        border-radius: var(--radius-full);
        background: var(--gradient-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 1.25rem;
    }
    
    .testimonial-name {
        font-weight: 700;
    }
    
    .testimonial-role {
        font-size: 0.875rem;
        color: #6b7280;
    }
    
    /* ============================================
       🦶 Footer
       ============================================ */
    .customer-footer {
        background: #111827;
        color: white;
        padding: 80px 0 30px;
        margin-top: 100px;
    }
    
    .footer-brand {
        font-family: var(--font-display);
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .footer-brand i {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .footer-description {
        color: #9ca3af;
        margin-bottom: 1.5rem;
        max-width: 300px;
    }
    
    .footer-social {
        display: flex;
        gap: 1rem;
    }
    
    .footer-social a {
        width: 45px;
        height: 45px;
        border-radius: var(--radius-full);
        background: rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
