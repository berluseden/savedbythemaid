@* ============================================
   📅 BOOKING PAGE - SavedByTheMaid
   Modern Multi-Step Booking Flow
   Bootstrap 5.3 + AOS Animations
   ============================================ *@
@{
    ViewData["Title"] = "Reservar Servicio";
}

<!-- Booking Header -->
<section class="booking-header py-5">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="section-badge">📅 Reserva Online</span>
            <h1 class="section-title">
                Agenda tu <span class="highlight">limpieza</span>
            </h1>
            <p class="section-subtitle">
                Proceso rápido y fácil. En solo 3 pasos tendrás tu servicio confirmado.
            </p>
        </div>
    </div>
</section>

<!-- Booking Steps Progress -->
<section class="py-4">
    <div class="container">
        <div class="booking-steps" data-aos="fade-up" data-aos-delay="100">
            <div class="step-item active" data-step="1">
                <div class="step-circle">
                    <i class="bi bi-house-door"></i>
                </div>
                <span class="step-label">Tipo de Lugar</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" data-step="2">
                <div class="step-circle">
                    <i class="bi bi-door-open"></i>
                </div>
                <span class="step-label">Habitaciones</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" data-step="3">
                <div class="step-circle">
                    <i class="bi bi-stars"></i>
                </div>
                <span class="step-label">Servicio</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" data-step="4">
                <div class="step-circle">
                    <i class="bi bi-check-lg"></i>
                </div>
                <span class="step-label">Confirmar</span>
            </div>
        </div>
    </div>
</section>

<!-- Booking Form Container -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="booking-container" data-aos="fade-up" data-aos-delay="200">
                    
                    <!-- Step 1: Cleaning Place Type -->
                    <div class="booking-step-content active" id="step1">
                        <div class="step-header">
                            <h3><i class="bi bi-house-door me-2"></i>¿Qué tipo de lugar deseas limpiar?</h3>
                            <p class="text-muted">Selecciona el tipo de propiedad para continuar</p>
                        </div>
                        
                        <div class="service-select-grid" id="cleaningPlaceGrid">
                            <!-- Populated dynamically -->
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <p class="mt-3 text-muted">Cargando tipos de lugar...</p>
                            </div>
                        </div>
                        
                        <input type="hidden" id="selectedCleaningPlace" value="0">
                    </div>
                    
                    <!-- Step 2: Rooms/Spaces -->
                    <div class="booking-step-content" id="step2">
                        <div class="step-header">
                            <h3><i class="bi bi-door-open me-2"></i>¿Cuántas habitaciones?</h3>
                            <p class="text-muted">Selecciona el número de espacios a limpiar</p>
                        </div>
                        
                        <div class="service-select-grid" id="cleaningRoomGrid">
                            <!-- Populated dynamically -->
                        </div>
                        
                        <input type="hidden" id="selectedCleaningRoom" value="0">
                        
                        <div class="step-navigation mt-4">
                            <button type="button" class="btn-step-back" onclick="goToStep(1)">
                                <i class="bi bi-arrow-left me-2"></i>Anterior
                            </button>
                        </div>
                    </div>
                    
                    <!-- Step 3: Service Type -->
                    <div class="booking-step-content" id="step3">
                        <div class="step-header">
                            <h3><i class="bi bi-stars me-2"></i>¿Qué tipo de limpieza necesitas?</h3>
                            <p class="text-muted">Elige el servicio que mejor se adapte a tus necesidades</p>
                        </div>
                        
                        <div class="service-select-grid" id="serviceTypeGrid">
                            <!-- Populated dynamically -->
                        </div>
                        
                        <input type="hidden" id="selectedServiceType" value="0">
                        
                        <div class="step-navigation mt-4">
                            <button type="button" class="btn-step-back" onclick="goToStep(2)">
                                <i class="bi bi-arrow-left me-2"></i>Anterior
                            </button>
                        </div>
                    </div>
                    
                    <!-- Step 4: Contact & Confirm -->
                    <div class="booking-step-content" id="step4">
                        <div class="step-header">
                            <h3><i class="bi bi-person-lines-fill me-2"></i>Datos de Contacto</h3>
                            <p class="text-muted">Proporciona tus datos para confirmar la reserva</p>
                        </div>
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="customerName" placeholder="Nombre" required>
                                    <label for="customerName"><i class="bi bi-person me-1"></i>Nombre Completo</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="customerEmail" placeholder="Email" required>
                                    <label for="customerEmail"><i class="bi bi-envelope me-1"></i>Email</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="tel" class="form-control" id="customerPhone" placeholder="Teléfono" required>
                                    <label for="customerPhone"><i class="bi bi-telephone me-1"></i>Teléfono</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="customerAddress" placeholder="Dirección" required>
                                    <label for="customerAddress"><i class="bi bi-geo-alt me-1"></i>Dirección</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" id="additionalInfo" placeholder="Información adicional" style="height: 100px"></textarea>
                                    <label for="additionalInfo"><i class="bi bi-chat-dots me-1"></i>Información Adicional (opcional)</label>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Summary Card -->
                        <div class="booking-summary mt-4">
                            <h5><i class="bi bi-receipt me-2"></i>Resumen de tu Reserva</h5>
                            <div class="summary-items">
                                <div class="summary-item">
                                    <span class="summary-label">Tipo de Lugar:</span>
                                    <span class="summary-value" id="summaryPlace">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Habitaciones:</span>
                                    <span class="summary-value" id="summaryRooms">-</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Servicio:</span>
                                    <span class="summary-value" id="summaryService">-</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="step-navigation mt-4">
                            <button type="button" class="btn-step-back" onclick="goToStep(3)">
                                <i class="bi bi-arrow-left me-2"></i>Anterior
                            </button>
                            <button type="button" class="btn-primary-gradient" id="btnConfirmBooking">
                                <i class="bi bi-check-circle me-2"></i>Confirmar Reserva
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5" style="background: rgba(255,255,255,0.02);">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-box">
                    <i class="bi bi-shield-check"></i>
                    <h5>100% Garantizado</h5>
                    <p>Si no estás satisfecho, volvemos a limpiar gratis</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-box">
                    <i class="bi bi-calendar-check"></i>
                    <h5>Reserva Flexible</h5>
                    <p>Cambia o cancela hasta 24hrs antes sin cargo</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-box">
                    <i class="bi bi-headset"></i>
                    <h5>Soporte 24/7</h5>
                    <p>Estamos disponibles para ayudarte siempre</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    // Booking State
    const bookingState = {
        cleaningPlaceId: 0,
        cleaningPlaceName: '',
        cleaningRoomId: 0,
        cleaningRoomName: '',
        serviceTypeId: 0,
        serviceTypeName: ''
    };
    
    let currentStep = 1;
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadCleaningPlaces();
        loadFromLocalStorage();
    });
    
    // Load data from localStorage if available
    function loadFromLocalStorage() {
        const savedName = localStorage.getItem('Name');
        const savedEmail = localStorage.getItem('Email');
        const savedPhone = localStorage.getItem('Phone');
        const savedAddress = localStorage.getItem('Address');
        
        if (savedName) document.getElementById('customerName').value = savedName;
        if (savedEmail) document.getElementById('customerEmail').value = savedEmail;
        if (savedPhone) document.getElementById('customerPhone').value = savedPhone;
        if (savedAddress) document.getElementById('customerAddress').value = savedAddress;
    }
    
    // Load Cleaning Places
    function loadCleaningPlaces() {
        fetch('/Booking/GetAllCleaningPlace')
            .then(response => response.json())
            .then(data => {
                const grid = document.getElementById('cleaningPlaceGrid');
                grid.innerHTML = '';
                
                const icons = ['bi-house', 'bi-building', 'bi-shop', 'bi-hospital', 'bi-house-door', 'bi-buildings'];
                
                data.cleaningPlaces.forEach((place, index) => {
                    const card = createServiceCard(
                        place.id,
                        place.title,
                        icons[index % icons.length],
                        'cleaningPlace'
                    );
                    grid.appendChild(card);
                });
            })
            .catch(error => {
                console.error('Error loading cleaning places:', error);
                document.getElementById('cleaningPlaceGrid').innerHTML = 
                    '<div class="alert alert-danger">Error al cargar los tipos de lugar. Por favor recarga la página.</div>';
            });
    }
    
    // Load Rooms by Place ID
    function loadRoomsByPlace(placeId) {
        fetch(`/Booking/GetRoomsByCleaningPlaceId?Id=${placeId}`)
            .then(response => response.json())
            .then(data => {
                const grid = document.getElementById('cleaningRoomGrid');
                grid.innerHTML = '';
                
                data.cleaningPlaceRooms.forEach((room) => {
                    const card = createServiceCard(
                        room.id,
                        room.title,
                        'bi-door-open',
                        'cleaningRoom'
                    );
                    grid.appendChild(card);
                });
            });
    }
    
    // Load Service Types by Room ID
    function loadServiceTypes(roomId) {
        fetch(`/Booking/GetServiceTypeByPlaceRoomsId?Id=${roomId}`)
            .then(response => response.json())
            .then(data => {
                const grid = document.getElementById('serviceTypeGrid');
                grid.innerHTML = '';
                
                const icons = ['bi-stars', 'bi-sparkle', 'bi-droplet', 'bi-brush', 'bi-house-heart'];
                
                data.cleaningPlaceRooms.forEach((service, index) => {
                    const card = createServiceCard(
                        service.id,
                        service.title,
                        icons[index % icons.length],
                        'serviceType'
                    );
                    grid.appendChild(card);
                });
            });
    }
    
    // Create Service Selection Card
    function createServiceCard(id, title, icon, type) {
        const div = document.createElement('div');
        div.className = 'service-select-card';
        div.dataset.id = id;
        div.dataset.type = type;
        div.innerHTML = `
            <div class="service-select-icon">
                <i class="bi ${icon}"></i>
            </div>
            <h4>${title}</h4>
            <div class="service-select-check">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        `;
        
        div.addEventListener('click', function() {
            selectService(this, type, id, title);
        });
        
        return div;
    }
    
    // Handle Service Selection
    function selectService(element, type, id, title) {
        // Remove selection from siblings
        element.parentElement.querySelectorAll('.service-select-card').forEach(card => {
            card.classList.remove('selected');
        });
        
        // Add selection to clicked card
        element.classList.add('selected');
        
        // Update state and proceed
        if (type === 'cleaningPlace') {
            bookingState.cleaningPlaceId = id;
            bookingState.cleaningPlaceName = title;
            document.getElementById('selectedCleaningPlace').value = id;
            
            // Load rooms and go to step 2
            loadRoomsByPlace(id);
            setTimeout(() => goToStep(2), 300);
            
        } else if (type === 'cleaningRoom') {
            bookingState.cleaningRoomId = id;
            bookingState.cleaningRoomName = title;
            document.getElementById('selectedCleaningRoom').value = id;
            
            // Load service types and go to step 3
            loadServiceTypes(id);
            setTimeout(() => goToStep(3), 300);
            
        } else if (type === 'serviceType') {
            bookingState.serviceTypeId = id;
            bookingState.serviceTypeName = title;
            document.getElementById('selectedServiceType').value = id;
            
            // Update summary and go to step 4
            updateSummary();
            setTimeout(() => goToStep(4), 300);
        }
    }
    
    // Navigate to Step
    function goToStep(step) {
        currentStep = step;
        
        // Update step indicators
        document.querySelectorAll('.step-item').forEach((item, index) => {
            const stepNum = index + 1;
            item.classList.remove('active', 'completed');
            
            if (stepNum < step) {
                item.classList.add('completed');
            } else if (stepNum === step) {
                item.classList.add('active');
            }
        });
        
        // Update step content visibility
        document.querySelectorAll('.booking-step-content').forEach((content, index) => {
            const stepNum = index + 1;
            content.classList.remove('active');
            
            if (stepNum === step) {
                content.classList.add('active');
            }
        });
        
        // Scroll to top of form
        document.querySelector('.booking-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    
    // Update Summary
    function updateSummary() {
        document.getElementById('summaryPlace').textContent = bookingState.cleaningPlaceName || '-';
        document.getElementById('summaryRooms').textContent = bookingState.cleaningRoomName || '-';
        document.getElementById('summaryService').textContent = bookingState.serviceTypeName || '-';
    }
    
    // Confirm Booking
    document.getElementById('btnConfirmBooking').addEventListener('click', function() {
        const btn = this;
        
        // Get form values
        const name = document.getElementById('customerName').value.trim();
        const email = document.getElementById('customerEmail').value.trim();
        const phone = document.getElementById('customerPhone').value.trim();
        const address = document.getElementById('customerAddress').value.trim();
        const additionalInfo = document.getElementById('additionalInfo').value.trim();
        
        // Validate
        if (!name || !email || !phone || !address) {
            Swal.fire({
                icon: 'warning',
                title: 'Datos Incompletos',
                text: 'Por favor completa todos los campos requeridos.',
                confirmButtonColor: '#6366f1'
            });
            return;
        }
        
        // Save to localStorage
        localStorage.setItem('Name', name);
        localStorage.setItem('Email', email);
        localStorage.setItem('Phone', phone);
        localStorage.setItem('Address', address);
        localStorage.setItem('AdditionalInfo', additionalInfo);
        
        // Set cookies
        document.cookie = `name=${name};path=/;max-age=259200`;
        document.cookie = `email=${email};path=/;max-age=259200`;
        document.cookie = `phone=${phone};path=/;max-age=259200`;
        document.cookie = `address=${address};path=/;max-age=259200`;
        
        // Disable button
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';
        
        // Submit booking
        const bookObj = {
            CleaningPlaceId: bookingState.cleaningPlaceId,
            CleaningPlaceRoomId: bookingState.cleaningRoomId,
            ServiceTypeId: bookingState.serviceTypeId
        };
        
        fetch('/Booking/Book/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(bookObj)
        })
        .then(response => response.json())
        .then(data => {
            const cartItemId = data.cartItemId;
            document.cookie = `cartItemId=${cartItemId};path=/;max-age=259200`;
            
            const isAuthenticated = @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false");
            
            if (isAuthenticated === 'true') {
                window.location.href = `/Booking/ProcessToCheckOut?id=${cartItemId}`;
            } else {
                Swal.fire({
                    icon: 'info',
                    title: 'Iniciar Sesión',
                    text: 'Necesitas iniciar sesión para completar tu reserva.',
                    confirmButtonText: 'Continuar',
                    confirmButtonColor: '#6366f1'
                }).then(() => {
                    window.location.href = `/Account/Login/?returnUrl=/Booking/ProcessToCheckOut?id=${cartItemId}`;
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Confirmar Reserva';
            
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Hubo un problema al procesar tu reserva. Por favor intenta de nuevo.',
                confirmButtonColor: '#6366f1'
            });
        });
    });
</script>

<style>
    /* Additional Booking Page Styles */
    .booking-header {
        padding-top: 2rem;
    }
    
    .booking-step-content {
        display: none;
        animation: fadeIn 0.3s ease;
    }
    
    .booking-step-content.active {
        display: block;
    }
    
    .step-header {
        margin-bottom: 2rem;
        text-align: center;
    }
    
    .step-header h3 {
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }
    
    .service-select-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }
    
    .step-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.1);
    }
    
    .btn-step-back {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        color: var(--text-secondary);
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .btn-step-back:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.3);
        color: var(--text-primary);
    }
    
    .booking-summary {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 1rem;
        padding: 1.5rem;
    }
    
    .booking-summary h5 {
        color: var(--text-primary);
        margin-bottom: 1rem;
    }
    
    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .summary-item:last-child {
        border-bottom: none;
    }
    
    .summary-label {
        color: var(--text-secondary);
    }
    
    .summary-value {
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .feature-box {
        padding: 2rem;
    }
    
    .feature-box i {
        font-size: 2.5rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
    }
    
    .feature-box h5 {
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }
    
    .feature-box p {
        color: var(--text-secondary);
        margin: 0;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
}
